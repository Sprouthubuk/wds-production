APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production runs MySQL 8.4: the Verity draw engine's integrity triggers need MySQL/MariaDB or SQLite
# (its INTEGRATION.md, section 1), so PostgreSQL can't be used. Tests use in-memory SQLite (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wds
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_NAME="WDS Competitions"
APP_URL=https://api.wdscompetitions.co.uk
FRONTEND_URL=https://wdscompetitions.co.uk

# Ticket hold while the customer is on the hosted payment page
RAFFLE_RESERVATION_MINUTES=15

# Payments: fake (local only) | cashflows
PAYMENT_DRIVER=fake
CASHFLOWS_CONFIGURATION_ID=
CASHFLOWS_API_KEY=
CASHFLOWS_BASE_URL=
CASHFLOWS_WEBHOOK_SECRET=

# Verity draw engine (package sprouthub/verity-engine, see VERITY.md). Placeholders only: generate the
# keys on the server (forge/README.md, "Verity go-live") and keep an offline copy. Never commit real values.
# VERITY_BEACON: drand in production (anything else is refused); local is for offline development only.
VERITY_BEACON=drand
VERITY_SEED_KEY=
VERITY_OWNER_PEPPER=
VERITY_TSA_URL=http://timestamp.digicert.com
# Operators who get stuck-draw, late-close (G-11) and other alerts. Comma-separated.
VERITY_ALERT_EMAILS=ops@example.com
# Independent people (not the operator) who receive anchors and close/redraw witnesses. Comma-separated.
VERITY_ANCHOR_EMAILS=auditor@example.org
VERITY_VERIFY_URL=https://wdscompetitions.co.uk/verify
# VERITY_STUCK_DRAW_MINUTES=15
# VERITY_ROUTES=false

# First admin account (seeded by `php artisan db:seed`)
SEED_ADMIN_EMAIL=jason@wdsoriginals.com
SEED_ADMIN_PASSWORD=

QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=competitions@wdsoriginals.com
MAIL_FROM_NAME="WDS Competitions"
