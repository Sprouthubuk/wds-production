APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_NAME="WDS Competitions"
APP_URL=https://api.wdscompetitions.co.uk
FRONTEND_URL=https://wdscompetitions.co.uk

# Ticket hold while the customer is on the hosted payment page
RAFFLE_RESERVATION_MINUTES=15

# Payments: fake (local only) | cashflows
PAYMENT_DRIVER=fake
CASHFLOWS_CONFIGURATION_ID=
CASHFLOWS_API_KEY=
CASHFLOWS_BASE_URL=
CASHFLOWS_WEBHOOK_SECRET=

# Draw engine: commit-reveal (built-in interim) | verity
DRAW_ENGINE=commit-reveal
VERITY_BASE_URL=
VERITY_API_KEY=

# First admin account (seeded by `php artisan db:seed`)
SEED_ADMIN_EMAIL=jason@wdsoriginals.com
SEED_ADMIN_PASSWORD=

QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=competitions@wdsoriginals.com
MAIL_FROM_NAME="WDS Competitions"
