---
import { thumb } from '../lib/images';
import type { Competition } from '../lib/types';
import { money, odds, percentSold, statusLabel } from '../lib/pricing';
import { countdownParts } from '../lib/countdown';
import { isComingSoon } from '../lib/coming-soon';
interface Props { competition: Competition }
const { competition: c } = Astro.props;
const pct = percentSold(c.ticketsSold, c.totalTickets);
const left = Math.max(0, c.totalTickets - c.ticketsSold);
const href = `/competitions/${c.slug}`;
// Coming soon: badge, countdown to the opening, odds, tickets and price; "Notify me" instead of Enter.
const soon = isComingSoon(c);
const opensShort = soon && c.opensAt ? new Date(c.opensAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'Europe/London' }) : null;
const drawDate = c.drawAt ? new Date(c.drawAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'Europe/London' }) : 'TBC';
---
<article class="card comp">
  <a href={href} class="zoom media">
    {c.images[0] ? <img src={thumb(c.images[0].src)} alt={c.images[0].alt ?? c.title} loading="lazy" width="720" height="540" data-fade style={`view-transition-name: comp-${c.id}`} />
      : <span class="no-photo" role="img" aria-label={`Photos of the ${c.title} coming soon`}><span class="small">Photos coming soon</span></span>}
    {soon ? <span class="badge badge--soon">Coming soon</span> : c.badge ? <span class="badge">{c.badge}</span> : null}
    {opensShort ? <span class="when"><span>Entries open</span><span>{opensShort}</span></span> : <span class="when"><span>Live draw</span><span>{drawDate}</span></span>}
  </a>
  <div class="card__body">
    <h3 class="h3"><a href={href}>{c.title}</a></h3>
    {c.cashAlternative ? <span class="small muted cash">or {money(c.cashAlternative)} cash alternative</span> : null}
    {soon ? (
      <>
        {c.opensAt ? <div class="row-between small"><span class="muted">Opens in</span><b class="num" data-countdown={c.opensAt} data-countdown-text>{countdownParts(c.opensAt).text}</b></div> : null}
        <div class="row-between small muted"><span>Only {c.totalTickets.toLocaleString('en-GB')} {c.ticketPrice === 0 ? 'entries' : 'tickets'}</span><span><strong class="odds">{odds(c.totalTickets)}</strong> odds</span></div>
      </>
    ) : (
      <>
        <div class="row-between"><strong><span class="num" data-count-to={`${pct}%`}>{pct}%</span> sold</strong><span class="chip chip--solid">{statusLabel(c.ticketsSold, c.totalTickets)}</span></div>
        <div class="progress"><span style={`width:${pct}%`}></span></div>
        <div class="row-between small muted"><span>{left.toLocaleString('en-GB')} left</span><span>{odds(c.totalTickets)} odds</span></div>
      </>
    )}
    <div class="row-between prices">{c.ticketPrice === 0 ? <span><strong>Free</strong> to enter</span> : <span><strong>{money(c.ticketPrice)}</strong> online</span>}{c.ticketPrice === 0 ? <span>One per person</span> : null}</div>
    {soon ? (
      <a href={`${href}#notify`} class="btn btn--block notify-btn">Notify me when it's live</a>
    ) : (
      <a href={href} class="btn btn--block">{c.ticketPrice === 0 ? 'Enter free' : 'Enter now'}</a>
    )}
  </div>
</article>

<style>
  .no-photo { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 4 / 3; background: repeating-linear-gradient(135deg, #0b0b0b 0 14px, #0e0e0e 14px 28px); color: var(--muted); letter-spacing: .14em; text-transform: uppercase; }
  .media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .badge { position: absolute; top: 14px; left: 14px; background: #fff; color: #000; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 7px 10px; }
  .when { position: absolute; bottom: 14px; left: 14px; right: 14px; display: flex; justify-content: space-between; background: rgba(0,0,0,.78); padding: 10px 12px; font-size: 13px; font-weight: 700; }
  .badge--soon { background: rgba(0,0,0,.75); color: #fff; border: 1px solid rgba(255,255,255,.6); }
  .odds { color: #fff; font-size: 15px; }
  .notify-btn { min-height: 48px; font-size: 12px; letter-spacing: 0.08em; }
  .h3 a { text-decoration: none; }
  .cash { margin-top: -6px; }
  .row-between { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .prices { font-size: 13px; color: var(--muted-2); }
  .prices strong { font-size: 22px; color: #fff; }
</style>
