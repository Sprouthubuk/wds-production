---
/**
 * Pre-launch hero: the home page while no competition is live, and the "Launching soon" page for a
 * draft's slug. Only the teaser (first image, title, draw date), a countdown to the live draw and
 * the "Get first access" sign-up. The countdown targets the entries-open date while it's ahead
 * ("Entries open in"), otherwise the live draw ("Live draw in"). No prices, ticket counts or entry buttons.
 */
import type { CompetitionTeaser } from '../lib/types';
import { countdownParts } from '../lib/countdown';
import { launchCountdown } from '../lib/prelaunch';
import SignupForm from './SignupForm.astro';
interface Props { teaser: CompetitionTeaser; chip?: string }
const { teaser, chip = 'Coming soon' } = Astro.props;
const drawLabel = teaser.drawAt
  ? new Date(teaser.drawAt).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Europe/London' }).replace(' at ', ', ')
  : null;
const target = launchCountdown(teaser);
const cd = target ? countdownParts(target.at) : null;
const opensLabel = target?.label === 'Entries open in'
  ? new Date(target.at).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Europe/London' }).replace(' at ', ', ')
  : null;
---
<section class="launch">
  {teaser.image ? <img src={teaser.image.src} alt={teaser.image.alt} class="launch-img" fetchpriority="high" decoding="async" /> : null}
  <div class="launch-shade"></div>
  <div class="container launch-inner">
    <div class="launch-copy launch-anim">
      <span class="chip chip--line launch-chip"><span class="dot"></span>{chip}</span>
      <h1 class="display display--xl launch-title">{teaser.title}</h1>
      {drawLabel ? <p class="lead launch-lead">Live draw {drawLabel}</p> : null}
      {opensLabel ? <p class="lead launch-lead launch-opens">Entries open {opensLabel}</p> : null}
      {cd && target ? (
        <div class="cd-wrap">
        <span class="cd-label" id="launch-cd-label">{target.label}</span>
        <div class="cd" data-countdown={target.at} role="timer" aria-label={`${target.aria}, ${opensLabel ?? drawLabel}`}>
          <div><b data-unit="d">{cd.d}</b><span>Days</span></div>
          <div><b data-unit="h">{cd.h}</b><span>Hours</span></div>
          <div><b data-unit="m">{cd.m}</b><span>Mins</span></div>
          <div><b data-unit="s">{cd.s}</b><span>Secs</span></div>
        </div>
        </div>
      ) : null}
    </div>
    <div class="launch-card" id="first-access">
      <span class="label">Get first access</span>
      <p class="body">Be first to know when entries open. One email at launch, then live draw reminders. No spam.</p>
      <SignupForm id="launch-email" />
      <a href="/free-postal-entry" class="link-caps small">Free postal entry on every competition →</a>
    </div>
  </div>
</section>

<style>
  .launch { position: relative; border-bottom: 1px solid var(--line); overflow: hidden; }
  .launch-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; animation: settle 2.6s var(--ease) both, fade 1.2s ease both; }
  .launch-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.7) 40%, rgba(0,0,0,.2) 72%, rgba(0,0,0,.4) 100%), linear-gradient(0deg, #000 0%, rgba(0,0,0,0) 32%); }
  .launch-inner { position: relative; min-height: 700px; padding-top: 96px; padding-bottom: 72px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; }
  .launch-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .launch-anim > * { animation: rise 1.1s var(--ease) both; }
  .launch-anim > :nth-child(2) { animation-delay: .08s; }
  .launch-anim > :nth-child(3) { animation-delay: .16s; }
  .launch-anim > :nth-child(4) { animation-delay: .24s; }
  .launch-chip { align-self: flex-start; background: rgba(0,0,0,.5); border-color: rgba(255,255,255,.4); }
  .launch-title { overflow-wrap: break-word; margin: 0; }
  .launch-lead { color: #d6d6d6; margin: 0; }
  .launch-opens { margin-top: -14px; }
  .cd-wrap { display: flex; flex-direction: column; gap: 10px; }
  .cd-label { font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #fff; }
  .cd { display: grid; grid-template-columns: repeat(4, minmax(0, 92px)); gap: 8px; }
  .cd > div { border: 1px solid rgba(255,255,255,.35); background: rgba(0,0,0,.5); padding: 14px 6px 10px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .cd b { font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums; }
  .cd span { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted-2); }
  .launch-card { flex: 0 1 420px; min-width: 0; background: rgba(8,8,8,.9); border: 1px solid rgba(255,255,255,.22); padding: 28px; display: flex; flex-direction: column; gap: 16px; animation: rise 1.2s var(--ease) .3s both; }
  .launch-card .body { margin: 0; color: #d0d0d0; }
  @media (max-width: 1000px) { .launch-card { flex: 1 1 100%; max-width: 560px; } .launch-inner { min-height: 0; gap: 32px; } }
  @media (max-width: 600px) {
    .launch-inner { padding-top: 48px; padding-bottom: 40px; }
    .launch-shade { background: linear-gradient(180deg, rgba(0,0,0,.5) 0%, rgba(0,0,0,.78) 45%, #000 100%); }
    .launch-card { padding: 20px; }
    .cd b { font-size: 28px; }
  }
  @media (prefers-reduced-motion: reduce) { .launch-img, .launch-anim > *, .launch-card { animation: none; } }
</style>
