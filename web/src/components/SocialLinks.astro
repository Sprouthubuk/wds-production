---
/**
 * Social links as icon + handle, in the order set in Admin → Settings → Social links (empty URL = hidden).
 * The network name is in the accessible name ("Instagram @wds_originals") so same-handle links are distinct.
 */
import type { SiteSettings } from '../lib/types';
import { NETWORK_NAMES, socialLinks } from '../lib/socials';
interface Props { settings: SiteSettings; class?: string }
const { settings, class: cls } = Astro.props;
const links = socialLinks(settings);
---
{links.length ? (
  <ul class:list={['socials', cls]} data-socials>
    {links.map((l) => (
      <li>
        <a href={l.url} target="_blank" rel="noopener" data-social={l.network}>
          {l.network === 'instagram' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8"></circle></svg>
            : l.network === 'youtube' ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg>
            : <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"></rect><path d="M15.5 8H14a2 2 0 0 0-2 2v11M10 13h5"></path></svg>}
          <span>{l.label === NETWORK_NAMES[l.network] ? l.label : <><span class="sr-only">{NETWORK_NAMES[l.network]} </span>{l.label}</>}</span>
        </a>
      </li>
    ))}
  </ul>
) : null}

<style>
  .socials { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .socials a { min-height: 44px; display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-size: 14px; transition: opacity .3s; }
  .socials a:hover { opacity: .6; }
  .socials svg { flex: none; }
  /* Phones: a neat two-column grid. */
  @media (max-width: 700px) {
    .socials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; width: 100%; }
    .socials a { font-size: 13px; overflow-wrap: anywhere; }
  }
</style>
