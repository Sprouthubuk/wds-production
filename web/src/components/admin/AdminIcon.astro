  orders: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6M9 16h3"/>',
  customers: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20a6 6 0 0 1 12 0M15.5 4.3a3.2 3.2 0 0 1 0 7.4M17.5 14.4A6 6 0 0 1 21 20"/>',
