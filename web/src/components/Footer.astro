---
import type { SiteSettings } from '../lib/types';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
---
<footer class="site-footer">
  <div class="container inner">
    <div class="postal" data-reveal>
      <div class="stack" style="gap: 6px">
        <span class="h">Free postal entry on every paid competition</span>
        <span class="muted">Enter any paid competition free by post. Postal entries have exactly the same chance of winning as online entries.</span>
      </div>
      <a href="/free-postal-entry" class="btn">How to enter by post</a>
    </div>
    <div class="cols">
      <div class="brand stack">
        <img src="/images/wds-logo.png" alt="WDS Competitions" width="160" height="22" />
        <a href={`mailto:${settings.supportEmail}`} class="muted">{settings.supportEmail}</a>
        <div class="row socials">
          <a href={`https://instagram.com/${settings.drawsInstagram}`} aria-label={`Instagram @${settings.drawsInstagram}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8"></circle></svg></a>
          <a href={settings.youtubeUrl} aria-label="YouTube WDS Originals"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg></a>
        </div>
      </div>
      <nav aria-label="Competitions"><span class="label">Competitions</span><a href="/competitions">Live competitions</a><a href="/live-draws">Live draws &amp; results</a><a href="/verify">Verify a draw</a><a href="/winners">Winners</a><a href="/how-it-works">How it works</a></nav>
      <nav aria-label="Help"><span class="label">Help</span><a href="/free-postal-entry">Free postal entry</a><a href="/faqs">FAQs</a><a href="/responsible-play">Responsible play</a><a href="/contact">Contact us</a></nav>
      <nav aria-label="Company"><span class="label">Company</span><a href="/about">About WDS</a><a href="/our-commitment">Our commitment</a><a href="/draw-process">Draw process</a><a href="https://wdsoriginals.com">WDS Originals ↗</a></nav>
      <nav aria-label="Policies"><span class="label">Policies</span><a href="/terms">Terms &amp; conditions</a><a href="/website-terms">Website terms</a><a href="/privacy">Privacy</a><a href="/cookies">Cookies</a><a href="/refunds">Refunds</a><a href="/complaints">Complaints</a></nav>
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} {settings.legalName}, trading as {settings.tradingName}. Registered in England &amp; Wales, company no. {settings.companyNumber}. Registered office: {settings.registeredOffice}. 18+ UK residents only.</span>
      <span>Powered by RaffleLabs</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); }
  .inner { padding-top: 56px; padding-bottom: 36px; display: flex; flex-direction: column; gap: 44px; }
  .postal { border: 1px solid #fff; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .postal .stack { flex: 1 1 420px; }
  .postal .h { font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .postal .muted { font-size: 14px; }
  .cols { display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; }
  .brand { flex: 1 1 260px; gap: 16px; }
  .brand img { height: 22px; width: auto; }
  .socials { gap: 4px; margin-left: -12px; }
  .socials a { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
  nav { flex: 0 1 180px; display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  nav a { text-decoration: none; }
  nav a { transition: color .3s; color: var(--muted-2); }
  nav a:hover { color: #fff; }
  .socials a { transition: opacity .3s; }
  .socials a:hover { opacity: .6; }
  @media (max-width: 700px) {
    .inner { padding-top: 40px; gap: 36px; }
    .postal { padding: 22px; }
    .postal .btn { width: 100%; }
    .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 20px; }
    .brand { grid-column: 1 / -1; }
    nav { gap: 10px; }
    .legal { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
  .legal { border-top: 1px solid var(--line); padding-top: 22px; display: flex; flex-wrap: wrap; gap: 10px 32px; justify-content: space-between; font-size: 12px; color: #8a8a8a; }
</style>
