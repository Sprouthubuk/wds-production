---
import type { SiteSettings } from '../lib/types';
import { footerConfig, legalParts, PAYMENT_MARKS, SUPPORT_LINKS } from '../lib/footer';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const f = footerConfig(settings);
const NAV: [string, [string, string][]][] = [
  ['Competitions', [['/competitions', 'Live competitions'], ['/live-draws', 'Live draws & results'], ['/verify', 'Verify a draw'], ['/winners', 'Winners'], ['/how-it-works', 'How it works']]],
  ['Help', [['/free-postal-entry', 'Free postal entry'], ['/faqs', 'FAQs'], ['/responsible-play', 'Responsible play'], ['/contact', 'Contact us']]],
  ['Company', [['/about', 'About WDS'], ['/our-commitment', 'Our commitment'], ['/draw-process', 'Draw process'], ['https://wdsoriginals.com', 'WDS Originals ↗']]],
  ['Policies', [['/terms', 'Terms & conditions'], ['/website-terms', 'Website terms'], ['/privacy', 'Privacy'], ['/cookies', 'Cookies'], ['/refunds', 'Refunds'], ['/complaints', 'Complaints']]],
];
---
<footer class="site-footer" data-footer>
  <div class="container inner">
    <div class="brand-row" data-footer-brand>
      <div class="brand">
        <a href="/" class="logo" aria-label="WDS Competitions home"><img src="/images/wds-logo.png" alt="WDS Competitions" width="200" height="28" loading="lazy" data-logo /></a>
        <p class="strap">Win genuine WDS Originals builds. Every draw streamed live.</p>
      </div>
      <div class="socials">
        <a href={f.instagram.url} aria-label={`Instagram @${f.instagram.handle}`} rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8"></circle></svg></a>
        <a href={f.youtube.url} aria-label={`YouTube ${f.youtube.name}`} rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4"></rect><path d="M10 9.5v5l4.5-2.5z"></path></svg></a>
      </div>
    </div>

    <div class="cols">
      {NAV.map(([label, links]) => (
        <nav aria-label={label}><span class="label">{label}</span>{links.map(([href, text]) => <a href={href}>{text}</a>)}</nav>
      ))}
    </div>

    <div class="info">
      <section class="block" aria-labelledby="ft-contact" data-footer-contact>
        <h2 class="label" id="ft-contact">Contact us</h2>
        <a href={`mailto:${settings.supportEmail}`} class="email">{settings.supportEmail}</a>
        <a href="/contact" class="more">Send us a message →</a>
      </section>
      <section class="block rp" aria-labelledby="ft-rp" data-footer-rp>
        <span class="badge" aria-label="18 plus only">18+</span>
        <div>
          <h2 class="label" id="ft-rp">Play responsibly</h2>
          <p class="small-copy">Set limits or take a break from your account at any time. Free, confidential support is available.</p>
          <div class="rp-links">
            <a href="/responsible-play">Responsible play</a>
            {SUPPORT_LINKS.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
          </div>
        </div>
      </section>
    </div>

    <div class="payments" data-footer-payments>
      <span>Secure payments by Cashflows</span>
      <ul class="marks">{PAYMENT_MARKS.map((m) => <li><img src={`/images/payments/${m.key}.svg`} alt={m.alt} width="40" height="24" loading="lazy" /></li>)}</ul>
      <span class="debit">Debit cards only</span>
    </div>

    <div class="legal" data-footer-legal>
      <p>{legalParts(settings).map((part, i) => <>{i > 0 ? <span class="sep" aria-hidden="true"> · </span> : null}<span class="part">{part}</span></>)}</p>
      {f.poweredBy ? <p class="powered" data-powered-by>Powered by RaffleLabs</p> : null}
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); }
  .inner { padding-top: 56px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 40px; }

  /* Brand: the logo is sized by height only, so it keeps its natural 900×126 shape (never stretched). */
  .brand-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .brand { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; }
  .logo { display: inline-flex; }
  .logo img { height: 28px; width: auto; max-width: none; object-fit: contain; }
  .strap { margin: 0; font-size: 14px; color: var(--muted-2); }
  .socials { display: flex; gap: 4px; margin-right: -12px; }
  .socials a { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #fff; transition: opacity .3s; }
  .socials a:hover { opacity: .6; }

  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; border-top: 1px solid var(--line); padding-top: 36px; }
  nav { display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .label { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #fff; margin: 0 0 4px; }
  nav a, .rp-links a, .more { text-decoration: none; padding: 4px 0; margin: -4px 0; color: var(--muted-2); transition: color .3s; }
  nav a:hover, .rp-links a:hover, .more:hover { color: #fff; }

  .info { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; border-top: 1px solid var(--line); padding-top: 36px; }
  .block { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .email { color: #fff; font-size: 16px; text-underline-offset: 4px; overflow-wrap: anywhere; align-self: flex-start; }
  .more { align-self: flex-start; }
  .rp { flex-direction: row; gap: 16px; align-items: flex-start; }
  .badge { flex: none; width: 40px; height: 40px; border: 1.5px solid #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; letter-spacing: .02em; }
  .small-copy { margin: 0 0 10px; color: var(--muted-2); font-size: 13px; line-height: 1.55; max-width: 46ch; }
  .rp-links { display: flex; flex-wrap: wrap; gap: 8px 22px; }

  .payments { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; border-top: 1px solid var(--line); padding-top: 28px; font-size: 13px; color: var(--muted-2); }
  .marks { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .marks img { height: 24px; width: auto; display: block; }
  .debit { color: #fff; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; }

  .legal { border-top: 1px solid var(--line); padding-top: 22px; display: flex; flex-direction: column; gap: 10px; font-size: 12px; line-height: 1.6; color: #8a8a8a; }
  .legal p { margin: 0; }
  .powered { font-size: 11px; color: #767676; letter-spacing: .04em; } /* subtle, still 4.5:1 on black */

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .info { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 700px) {
    .inner { padding-top: 40px; gap: 32px; }
    .logo { min-height: 44px; align-items: center; }
    .logo img { height: 24px; }
    .brand { flex-direction: column; align-items: flex-start; }
    .brand-row { align-items: flex-start; }
    /* 44px tap targets on phones; the text stays where it was. */
    nav { gap: 0; }
    .label { margin-bottom: 6px; }
    nav a, .rp-links a, .more, .email { min-height: 44px; display: flex; align-items: center; padding: 0; margin: 0; }
    .rp-links { gap: 0 22px; }
    .payments { gap: 12px 14px; }
    .legal .sep { display: none; }
    .legal .part { display: block; }
    .legal { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
</style>
