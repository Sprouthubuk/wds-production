---
import '../styles/global.css';
import '../styles/admin.css';
import AdminIcon from '../components/admin/AdminIcon.astro';
import { adminGet, currentAdmin } from '../lib/admin';
import { usingSampleData } from '../lib/api';
import { signInUrl } from '../lib/auth-gate';

interface Props { title: string; active: string; staffOk?: boolean }
const { title, active, staffOk = false } = Astro.props;
// Signed in by src/middleware.ts (which redirects to /sign-in?next=… otherwise).
const admin = Astro.locals.admin ?? (await currentAdmin(Astro.cookies));
if (!admin) return Astro.redirect(signInUrl(Astro.url.pathname + Astro.url.search));
if (!admin.isAdmin && !staffOk) return Astro.redirect('/admin/event-sales');

type Key = 'dashboard' | 'competitions' | 'launch-alerts' | 'orders' | 'customers' | 'event-sales' | 'promotions' | 'draws' | 'winners' | 'postal' | 'responsible-play' | 'reports' | 'settings';
// [key, label, href, adminOnly]; staff see only the pages open to them (event sales, postal entries).
const groups: [string, [Key, string, string, boolean][]][] = [
  ['Overview', [['dashboard', 'Dashboard', '/admin', true]]],
  ['Sales', [['competitions', 'Competitions', '/admin/competitions', true], ['orders', 'Orders', '/admin/orders', true], ['customers', 'Customers', '/admin/customers', true], ['event-sales', 'Event sales', '/admin/event-sales', false], ['promotions', 'Promotions', '/admin/promotions', true], ['launch-alerts', 'Launch alerts', '/admin/launch-alerts', true]]],
  ['Draws', [['draws', 'Draws', '/admin/draws', true], ['winners', 'Winners', '/admin/winners', true], ['postal', 'Postal entries', '/admin/postal', false]]],
  ['Compliance', [['responsible-play', 'Responsible play', '/admin/responsible-play', true], ['reports', 'Reports', '/admin/reports', true]]],
  ['Settings', [['settings', 'Settings', '/admin/settings', true]]],
];
const visible = groups.map(([g, items]) => [g, items.filter(([, , , adminOnly]) => admin.isAdmin || !adminOnly)] as const).filter(([, items]) => items.length);
const group = groups.find(([, items]) => items.some(([k]) => k === active));
const section = group?.[1].find(([k]) => k === active);
const crumbs: [string, string | null][] = [['Admin', '/admin']];
if (group && group[0] !== 'Overview' && group[0] !== section?.[1]) crumbs.push([group[0], null]);
if (section && section[1] !== title) crumbs.push([section[1], section[2]]);

// The environment badge: amber STAGING unless the API's APP_URL is the real production address.
const env = await adminGet<{ data: { production: boolean; label: string } }>(Astro.cookies, '/environment').then((r) => r.data).catch(() => null);
const q = active === 'search' ? (Astro.url.searchParams.get('q') ?? '') : '';
const initials = `${admin.firstName?.[0] ?? ''}${admin.lastName?.[0] ?? ''}`.toUpperCase() || 'A';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" />
  <title>{title} · WDS Admin</title>
  <script is:inline>try { if (localStorage.getItem('wds-adm-collapsed') === '1') document.documentElement.classList.add('adm-collapsed'); } catch (e) {}</script>
</head>
<body class="adm">
  <a class="adm-skip" href="#adm-content">Skip to content</a>
  <aside class="adm-side" id="adm-side" aria-label="Admin menu" data-adm-side>
    <div class="adm-side-top">
      <a href={admin.isAdmin ? '/admin' : '/admin/event-sales'} class="adm-logo"><img src="/images/wds-logo.png" alt="WDS Competitions" width="120" height="17" /></a>
      <button type="button" class="adm-iconbtn adm-drawer-close" aria-label="Close menu" data-adm-close><AdminIcon name="close" /></button>
    </div>
    <nav aria-label="Admin" class="adm-navs">
      {visible.map(([g, items]) => (
        <div class="adm-group">
          <span class="adm-group-label">{g}</span>
          {items.map(([key, label, href]) => (
            <a href={href} class:list={['adm-nav', { on: key === active }]} aria-current={key === active ? 'page' : undefined} title={label}>
              <AdminIcon name={key} /><span class="adm-nav-text">{label}</span>
            </a>
          ))}
        </div>
      ))}
    </nav>
    <div class="adm-side-foot">
      <a href="/" target="_blank" rel="noopener" class="adm-nav" title="View site"><AdminIcon name="external" /><span class="adm-nav-text">View site</span></a>
      <button type="button" class="adm-nav adm-collapse" data-adm-collapse aria-pressed="false" title="Collapse menu"><AdminIcon name="collapse" /><span class="adm-nav-text">Collapse menu</span></button>
    </div>
  </aside>
  <div class="adm-scrim" data-adm-scrim hidden></div>

  <div class="adm-body">
    <header class="adm-top">
      <button type="button" class="adm-iconbtn adm-menu" aria-label="Open menu" aria-controls="adm-side" aria-expanded="false" data-adm-open><AdminIcon name="menu" /></button>
      <div class="adm-heading">
        <nav aria-label="Breadcrumb" class="adm-crumbs"><ol>{crumbs.map(([label, href]) => <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>)}</ol></nav>
        <h1 class="adm-title">{title}</h1>
      </div>
      <div class="adm-tools">
        {admin.isAdmin ? (
          <form class="adm-search" method="get" action="/admin/search" role="search">
            <label class="sr-only" for="adm-q">Search orders, customers and tickets</label>
            <AdminIcon name="search" size={18} />
            <input id="adm-q" name="q" type="search" value={q} placeholder="Order, email or ticket no." autocomplete="off" enterkeyhint="search" />
          </form>
        ) : null}
        {env ? <span class:list={['adm-env', env.production ? 'adm-env--live' : 'adm-env--staging']} data-adm-env title={env.production ? 'Live site: real customers and real payments' : 'Not the live site'}>{env.production ? 'Live' : 'Staging'}</span> : null}
        <details class="adm-user" data-adm-user>
          <summary aria-label={`Account: ${admin.firstName} ${admin.lastName}`}><span class="adm-avatar" aria-hidden="true">{initials}</span><span class="adm-user-name">{admin.firstName}</span><AdminIcon name="chevron" size={16} /></summary>
          <div class="adm-user-menu">
            <div class="adm-user-who"><strong>{admin.firstName} {admin.lastName}</strong><span class="small muted">{admin.email}</span><span class="small muted">{admin.isAdmin ? 'Admin' : 'Staff'}</span></div>
            <a href="/" target="_blank" rel="noopener">View site ↗</a>
            <form method="post" action="/api/admin-auth/logout"><button class="adm-link" type="submit">Sign out</button></form>
          </div>
        </details>
      </div>
    </header>

    <main class="adm-main" id="adm-content" tabindex="-1">
      {usingSampleData ? <div class="adm-preview">Preview mode — showing sample data. Set <code>API_URL</code> to connect the live API.</div> : null}
      {Astro.slots.has('actions') ? <div class="adm-head"><div class="adm-head-actions"><slot name="actions" /></div></div> : null}
      <slot />
    </main>
  </div>
  <div class="adm-toast" role="status" aria-live="polite" hidden></div>

  <style is:global>
    .adm { --side: 248px; --amber: #f5b03a; display: grid; grid-template-columns: var(--side) minmax(0, 1fr); min-height: 100vh; background: #050505; }
    .adm-collapsed .adm { --side: 72px; }
    .adm-skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: #fff; color: #000; padding: 10px 14px; font-weight: 700; }
    .adm-skip:focus { top: 12px; }

    /* Sidebar */
    .adm-side { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 18px; padding: 20px 12px 16px; border-right: 1px solid var(--line); background: #000; overflow-y: auto; overflow-x: hidden; }
    .adm-side-top { display: flex; align-items: center; justify-content: space-between; min-height: 40px; padding: 0 10px; }
    .adm-logo { display: inline-flex; align-items: center; min-height: 40px; }
    .adm-logo img { height: 17px; width: auto; max-width: none; }
    .adm-navs { display: flex; flex-direction: column; gap: 18px; }
    .adm-group { display: flex; flex-direction: column; gap: 2px; }
    .adm-group-label { padding: 0 12px 6px; font-size: 10.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #8c8c8c; white-space: nowrap; }
    .adm-nav { display: flex; align-items: center; gap: 12px; min-height: 40px; padding: 0 12px; border: 0; background: none; width: 100%; font-size: 14px; text-align: left; text-decoration: none; color: var(--muted-2); border-radius: 8px; cursor: pointer; white-space: nowrap; position: relative; }
    .adm-nav svg { flex: none; opacity: .85; }
    .adm-nav:hover { background: #121212; color: #fff; }
    .adm-nav.on { background: #fff; color: #000; font-weight: 700; }
    .adm-nav.on svg { opacity: 1; }
    .adm-side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 2px; border-top: 1px solid var(--line); padding-top: 12px; }
    .adm-collapsed .adm-nav-text, .adm-collapsed .adm-group-label, .adm-collapsed .adm-logo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .adm-collapsed .adm-nav { justify-content: center; padding: 0; }
    .adm-collapsed .adm-group { border-top: 1px solid var(--line); padding-top: 10px; }
    .adm-collapsed .adm-group:first-child { border-top: 0; padding-top: 0; }
    .adm-collapsed .adm-collapse svg { transform: scaleX(-1); }
    .adm-iconbtn { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid transparent; border-radius: 8px; background: none; color: #fff; cursor: pointer; flex: none; }
    .adm-iconbtn:hover { background: #121212; }
    .adm-drawer-close, .adm-menu { display: none; }

    /* Top bar */
    .adm-body { min-width: 0; display: flex; flex-direction: column; }
    .adm-top { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 16px; min-height: 72px; padding: 10px 36px; background: rgba(5,5,5,.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .adm-heading { min-width: 0; flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; }
    .adm-crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 12px; color: #9a9a9a; }
    .adm-crumbs li + li::before { content: '/'; margin-right: 6px; color: #5c5c5c; }
    .adm-crumbs a { color: #b5b5b5; text-decoration: none; }
    .adm-crumbs a:hover { color: #fff; text-decoration: underline; }
    .adm-title { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; overflow-wrap: anywhere; }
    .adm-tools { display: flex; align-items: center; gap: 12px; flex: none; }
    .adm-search { position: relative; display: flex; align-items: center; }
    .adm-search svg { position: absolute; left: 12px; color: #9a9a9a; pointer-events: none; }
    .adm-search input { width: 280px; min-height: 40px; padding: 8px 12px 8px 38px; background: #0d0d0d; border: 1px solid var(--line-2); border-radius: 8px; color: #fff; }
    .adm-search input::placeholder { color: #8a8a8a; }
    .adm-search input:focus { border-color: #fff; outline: none; box-shadow: 0 0 0 3px rgba(255,255,255,.15); }
    .adm-env { display: inline-flex; align-items: center; min-height: 28px; padding: 0 10px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
    .adm-env--staging { background: var(--amber); color: #000; }
    .adm-env--live { border: 1px solid #5d5d5d; color: #d6d6d6; }
    .adm-user { position: relative; }
    .adm-user summary { list-style: none; display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 8px 0 4px; border-radius: 999px; cursor: pointer; color: #ddd; }
    .adm-user summary::-webkit-details-marker { display: none; }
    .adm-user summary:hover { background: #121212; }
    .adm-avatar { width: 32px; height: 32px; border-radius: 50%; background: #fff; color: #000; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; letter-spacing: .04em; }
    .adm-user-name { font-size: 14px; }
    .adm-user-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 40; min-width: 240px; display: flex; flex-direction: column; gap: 4px; padding: 8px; background: #0d0d0d; border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,.6); }
    .adm-user-who { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px 10px; border-bottom: 1px solid var(--line); margin-bottom: 4px; overflow-wrap: anywhere; }
    .adm-user-menu a, .adm-user-menu .adm-link { display: flex; align-items: center; min-height: 40px; padding: 0 10px; border-radius: 8px; font-size: 14px; color: #ddd; text-decoration: none; width: 100%; }
    .adm-user-menu a:hover, .adm-user-menu .adm-link:hover { background: #161616; color: #fff; }

    /* Page */
    .adm-main { padding: 28px 36px 64px; min-width: 0; outline: none; }
    .adm-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 16px; margin-bottom: 24px; }
    .adm-head-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .adm-scrim { position: fixed; inset: 0; z-index: 59; background: rgba(0,0,0,.6); }

    @media (max-width: 1100px) { .adm-search input { width: 200px; } .adm-user-name { display: none; } }
    /* Phones and small tablets: the sidebar becomes a slide-out drawer. */
    @media (max-width: 900px) {
      .adm, .adm-collapsed .adm { grid-template-columns: minmax(0, 1fr); }
      .adm-side { position: fixed; z-index: 60; left: 0; top: 0; bottom: 0; width: min(300px, 86vw); height: auto; transform: translateX(-102%); visibility: hidden; transition: transform .25s ease, visibility 0s linear .25s; box-shadow: 20px 0 60px rgba(0,0,0,.6); }
      .adm-side.open { transform: none; visibility: visible; transition: transform .25s ease; }
      .adm-collapsed .adm-nav-text, .adm-collapsed .adm-group-label, .adm-collapsed .adm-logo { position: static; width: auto; height: auto; clip: auto; }
      .adm-collapsed .adm-nav { justify-content: flex-start; padding: 0 12px; }
      .adm-nav { min-height: 44px; }
      .adm-collapse { display: none; }
      .adm-drawer-close, .adm-menu { display: inline-flex; }
      .adm-top { flex-wrap: wrap; padding: 10px 16px; gap: 8px 10px; min-height: 64px; }
      .adm-heading { flex: 1 1 0; }
      .adm-title { font-size: 19px; }
      .adm-tools { gap: 8px; }
      .adm-search { order: 5; flex: 1 1 100%; }
      .adm-search input { width: 100%; }
      .adm-tools { display: contents; }
      .adm-main { padding: 20px 16px 56px; }
    }
    @media (prefers-reduced-motion: reduce) { .adm-side { transition: none !important; } }
  </style>

  <script>
    import { initAdmin } from '../lib/admin-client';
    import { initShell } from '../lib/admin-shell';
    initShell();
    initAdmin();
  </script>
</body>
</html>
