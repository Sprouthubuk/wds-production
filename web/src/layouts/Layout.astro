---
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/api';
import { prelaunchState } from '../lib/prelaunch';

interface Props {
  title: string;
  description?: string;
  active?: 'competitions' | 'winners' | 'postal' | 'faqs' | 'none';
  image?: string;
}
const { title, description = 'Win genuine WDS Originals BMW builds, parts and merchandise. Low ticket numbers, better odds, free postal entry and every draw streamed live.', active = 'none', image = '/images/e46-clubsport-34.jpg' } = Astro.props;
const [settings, pre] = await Promise.all([getSettings(), prelaunchState(Astro.locals)]);
const preview = Astro.locals.preview ?? null;
const fullTitle = title === 'Home' ? 'WDS Competitions — Win genuine WDS Originals builds' : `${title} — WDS Competitions`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!document.documentElement.classList.contains('motion-on'))document.documentElement.classList.remove('js')},2500);</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : null}
    <slot name="head" />
  </head>
  <body class:list={[{ 'is-preview': !!preview }]}>
    {preview ? (
      <div class="preview-bar" role="status">
        <strong>Preview: not live yet. Entries are disabled.</strong>
        <a href="/preview/exit">Exit preview</a>
      </div>
    ) : null}
    <a class="sr-only" href="#main">Skip to content</a>
    <Header active={active} prelaunch={pre.on} firstAccessHref={pre.href} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
    <slot name="after" />
    <script>
      import { basketCount } from '../lib/basket';
      const update = () => {
        const n = basketCount();
        document.querySelectorAll<HTMLElement>('[data-basket-count]').forEach((el) => {
          el.textContent = String(n);
          el.hidden = n === 0;
        });
      };
      update();
      window.addEventListener('basket:change', update);
      window.addEventListener('storage', update);
    </script>
    <script>
      import { startCountdowns } from '../lib/countdown';
      import { initMotion } from '../lib/motion';
      initMotion();
      document.documentElement.classList.add('motion-on');
      startCountdowns();
    </script>
  </body>
</html>

<style is:global>
  /* Draft preview banner: fixed, always visible, never mistaken for the live site. */
  .preview-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 18px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: #fff; color: #000; border-top: 2px solid #000; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; text-align: center; }
  .preview-bar a { color: #000; font-weight: 700; }
  body.is-preview { padding-bottom: 64px; }
  body.is-preview .sticky-bar { bottom: 52px; }
</style>
