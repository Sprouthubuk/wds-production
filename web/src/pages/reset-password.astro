---
/** Opened from the password email (AccountPasswordLink): ?token=…&email=… */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
const token = Astro.url.searchParams.get('token') ?? '';
const email = Astro.url.searchParams.get('email') ?? '';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<Layout title="Choose a password">
  <meta slot="head" name="robots" content="noindex" />
  <PageHero eyebrow="Account" title="Choose a password" />
  <section class="section" style="border-bottom: 0">
    <div class="container" style="max-width: 560px">
      {token && email ? (
        <form class="box" data-reset novalidate>
          <input type="hidden" name="token" value={token} />
          <div class="field"><label for="rp-em">Email</label><input id="rp-em" name="email" type="email" required readonly value={email} autocomplete="username" /></div>
          <div class="field"><label for="rp-pw">New password</label><input id="rp-pw" name="password" type="password" required minlength="10" autocomplete="new-password" /><span class="hint">At least 10 characters.</span></div>
          <div class="field"><label for="rp-pw2">Type it again</label><input id="rp-pw2" name="password_confirmation" type="password" required minlength="10" autocomplete="new-password" /></div>
          <p class="alert" data-msg role="status" aria-live="polite" hidden></p>
          <button class="btn btn--block" type="submit">Save password</button>
        </form>
      ) : (
        <div class="box"><p class="body" style="margin:0">This link is incomplete. Ask for a new one.</p><a href="/forgot-password" class="btn">Send me a new link</a></div>
      )}
    </div>
  </section>
</Layout>
<style>
  .box { border: 1px solid #fff; padding: 36px; display: flex; flex-direction: column; gap: 18px; }
  @media (max-width: 600px) { .box { padding: 22px; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-reset]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const pw = form.elements.namedItem('password') as HTMLInputElement;
    const pw2 = form.elements.namedItem('password_confirmation') as HTMLInputElement;
    pw2.setCustomValidity(pw.value === pw2.value ? '' : "The passwords don't match.");
    if (!form.reportValidity()) return;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true;
    const body = Object.fromEntries(new FormData(form).entries());
    const res = await fetch('/api/auth/reset-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).catch(() => null);
    const data = res ? await res.json().catch(() => ({})) : {};
    if (res?.ok) {
      msg.textContent = data.message || 'Password saved.';
      msg.classList.remove('alert--error');
      msg.hidden = false;
      setTimeout(() => (window.location.href = '/sign-in'), 1500);
      return;
    }
    const first = data.errors ? Object.values(data.errors as Record<string, string[]>)[0]?.[0] : null;
    msg.textContent = first || data.message || 'Something went wrong. Please try again.';
    msg.classList.add('alert--error');
    msg.hidden = false;
    btn.disabled = false;
  });
</script>
