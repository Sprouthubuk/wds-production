---
import LegalPage from '../components/LegalPage.astro';
const sections: [string, string[]][] = [
  ["When we refund", ["We refund paid entries in full if: we can't issue your tickets (for example because the competition sold out or your payment arrived after your order expired); we cancel a competition; or your entry is void because you're under 18 or self-excluded."]],
  ["When we don't refund", ["Once your ticket numbers are issued, your entry is complete and isn't refundable, except as above or where the law requires. If you charge back a payment, the tickets bought with it are void."]],
  ["How refunds are paid", ["Refunds go back to the card you paid with, usually within 5 to 10 working days."]],
  ['Asking for a refund', ['Contact us using the details on the <a href="/contact">contact page</a>, with your order number.']],
];
---
<LegalPage title={'Refunds policy'} heading={'Refunds policy'} sections={sections} updated="20 November 2026" />
