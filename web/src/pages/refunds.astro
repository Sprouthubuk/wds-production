---
import LegalPage from '../components/LegalPage.astro';
const sections: [string, string[]][] = [
  ['When we refund', ["If we can't issue your tickets, for example because your payment arrived after your order expired or the tickets had sold out, we refund the payment in full and no tickets are issued."]],
  ['How refunds are paid', ['Refunds go back to the card you paid with.']],
  ['Asking for a refund', ['Contact us using the details on the <a href="/contact">contact page</a>, with your order number.']],
];
---
<LegalPage title={'Refunds policy'} heading={'Refunds policy'} sections={sections} />
