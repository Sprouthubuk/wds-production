---
import { drawChannels } from '../../lib/channels';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { api, ApiError, usingSampleData, getSettings } from '../../lib/api';
import { getToken } from '../../lib/session';
import { money } from '../../lib/pricing';

interface OrderView {
  reference: string;
  status: 'pending' | 'paid' | 'failed' | 'cancelled' | 'refunded';
  message?: string | null;
  total: number;
  lines: { competition: string; slug: string; qty: number; drawAt: string; ticketNumbers: string[] }[];
}

const { reference } = Astro.params;
const key = Astro.url.searchParams.get('key') ?? '';
const settings = await getSettings();
let order: OrderView | null = null;
if (usingSampleData) {
  order = { reference: reference!, status: 'paid', total: 40, lines: [{ competition: 'BMW E46 330Ci Clubsport', slug: 'bmw-e46-330ci-clubsport', qty: 3, drawAt: '2026-12-24T20:00:00Z', ticketNumbers: ['0466', '0467', '0468'] }] };
} else {
  try {
    order = (await api<{ data: OrderView }>(`/orders/${encodeURIComponent(reference!)}?key=${encodeURIComponent(key)}`, { token: getToken(Astro.cookies) })).data;
  } catch (e) {
    if (!(e instanceof ApiError && (e.status === 404 || e.status === 403))) throw e;
  }
}
if (!order) return Astro.rewrite('/404');
const waiting = order.status === 'pending';
const ch = drawChannels(settings);
---
<Layout title={order.status === 'paid' ? "You're in" : 'Order'}>
  {waiting ? <meta slot="head" http-equiv="refresh" content="4" /> : null}
  {order.status === 'paid' ? (
    <PageHero eyebrow={`Order ${order.reference}`} title="You're in" intro="Thanks for entering. Your ticket numbers are below and we've emailed them to you." />
  ) : waiting ? (
    <PageHero eyebrow={`Order ${order.reference}`} title="Confirming payment" intro="We're waiting for confirmation from the payment provider. This page will update automatically." />
  ) : (
    <PageHero eyebrow={`Order ${order.reference}`} title={order.status === 'refunded' ? 'Payment refunded' : 'Payment not completed'} intro={order.message ?? "Your payment didn't go through and no tickets were issued. Your basket is still saved."} />
  )}
  <section class="section" style="border-bottom: 0">
    <div class="container layout">
      <div class="stack" style="gap: 28px; flex: 1.4 1 520px">
        {order.lines.map((l) => (
          <div class="stack" style="gap: 14px">
            <span class="label">{l.competition} · {l.qty} ticket{l.qty === 1 ? '' : 's'}</span>
            {l.ticketNumbers.length ? (
              <div class="chips">{l.ticketNumbers.map((n) => <span class="num">{n}</span>)}</div>
            ) : <p class="body muted">{waiting ? 'Ticket numbers appear here as soon as payment is confirmed.' : 'No tickets issued.'}</p>}
          </div>
        ))}
        <div class="row" style="gap: 12px">
          {order.status === 'paid' ? <a href="/account" class="btn">View my tickets</a> : <a href="/basket" class="btn">Back to basket</a>}
          <a href="/competitions" class="btn btn--outline">Enter another competition</a>
        </div>
        {order.status === 'paid' ? <p class="small muted">{order.total === 0 ? 'Free entry: nothing to pay.' : `Total paid ${money(order.total)}.`}</p> : null}
      </div>
      <div class="watch">
        <span class="label">Watch the draw</span>
        <h2 class="h3" style="font-size: 22px">Live on {ch.where}</h2>
        <p class="small muted" style="margin:0">Follow so you don't miss your number.</p>
        {ch.primary ? <a href={ch.primary.url} class="btn btn--outline">{ch.primary.label}</a> : null}
        {ch.instagram && ch.youtube ? <a href={ch.youtube.url} class="btn btn--outline">Watch on YouTube</a> : null}
      </div>
    </div>
  </section>
  {order.status === 'paid' ? <div data-order-paid hidden></div> : null}
</Layout>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chips span { min-width: 88px; min-height: 52px; padding: 0 16px; border: 1px solid #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; }
  .watch { flex: 1 1 340px; border: 1px solid var(--line-2); padding: 28px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
</style>

<script>
  import { clearBasket } from '../../lib/basket';
  if (document.querySelector('[data-order-paid]')) clearBasket();
</script>
