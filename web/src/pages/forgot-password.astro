---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Forgotten password">
  <meta slot="head" name="robots" content="noindex" />
  <PageHero eyebrow="Account" title="Forgotten your password?" intro="Enter the email on your account and we'll send you a link to choose a new one." />
  <section class="section" style="border-bottom: 0">
    <div class="container" style="max-width: 560px">
      <form class="box" data-forgot novalidate>
        <div class="field"><label for="fp-em">Email</label><input id="fp-em" name="email" type="email" required autocomplete="email" /></div>
        <p class="alert" data-msg role="status" aria-live="polite" hidden></p>
        <button class="btn btn--block" type="submit">Send me a link</button>
        <a href="/sign-in" class="small muted">Back to sign in</a>
      </form>
    </div>
  </section>
</Layout>
<style>
  .box { border: 1px solid #fff; padding: 36px; display: flex; flex-direction: column; gap: 18px; }
  @media (max-width: 600px) { .box { padding: 22px; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-forgot]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    btn.disabled = true;
    const res = await fetch('/api/auth/forgot-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: (form.elements.namedItem('email') as HTMLInputElement).value }) }).catch(() => null);
    const data = res ? await res.json().catch(() => ({})) : {};
    const first = data.errors ? Object.values(data.errors as Record<string, string[]>)[0]?.[0] : null;
    msg.textContent = res?.ok ? data.message : first || data.message || 'Something went wrong. Please try again.';
    msg.classList.toggle('alert--error', !res?.ok);
    msg.hidden = false;
    btn.disabled = false;
  });
</script>
