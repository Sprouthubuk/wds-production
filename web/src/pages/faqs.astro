---
import { drawChannels } from '../lib/channels';
import { POSTAL_RULE } from '../lib/postal';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getSettings } from '../lib/api';
const settings = await getSettings();
type Faq = [q: string, a: string, link?: { href: string; label: string }];
const ch = drawChannels(settings);
const groups: [string, Faq[]][] = [
  ['Entering', [
    ['Who can enter?', "Anyone aged 18 or over who lives in the UK. Employees and contractors of WDS Originals Limited, their immediate families and households, and anyone professionally connected with running the competitions can't enter."],
    ['Can I enter for free?', 'Yes. Every paid competition can be entered free by post. Free competitions are entered online only, one entry per person.', { href: '/free-postal-entry', label: 'Free postal entry' }],
    ['Why is there a question before I pay?', "To enter a paid competition online, you answer a short multiple-choice question in your basket. If you get it wrong, nothing is charged and you can try again."],
    ['When do postal entries close?', `${POSTAL_RULE} The exact deadline is shown on each competition page.`],
    ['Does a postal entry have the same chance of winning?', 'Yes. Postal entries get ticket numbers from the same run as online entries and go into the same draw.'],
    ['How many times can I enter?', "If a competition has a maximum per person, it's shown on the competition page, and online and postal entries count towards it. Otherwise you can enter as many times as you like, as long as tickets remain available."],
  ]],
  ['Tickets & payment', [
    ['How do I pay?', "Add your tickets to the basket and pay on our payment provider's secure checkout page by debit card, Apple Pay or Google Pay. Any site credit in your account is used first."],
    ['Are there bundle deals?', 'Yes. Bundles are cheaper per ticket, and the basket always uses the cheapest combination.'],
    ['When do I get my ticket numbers?', 'As soon as payment completes. They are emailed to you and shown in your account.'],
    ['Can I get a refund?', 'Our refunds policy explains when entries are refunded.', { href: '/refunds', label: 'Refunds policy' }],
  ]],
  ['The draw', [
    ['When and where are draws held?', `Live on ${ch.where}. Each competition page shows its closing date and draw time.`],
    ['How is the winner chosen?', "When a competition closes, the entry list is locked and can't be changed. We then draw the winning number live from numbered chips, one for every ticket."],
    ['How do I check a draw?', 'Enter the draw reference (it starts WDS-) on the Verify a draw page. It shows the result and confirms the winning ticket was a genuine entry.', { href: '/verify', label: 'Verify a draw' }],
    ['What if not every ticket sells?', 'The draw still goes ahead on the stated date. Closing dates are not extended.'],
  ]],
  ['Winning', [
    ["How will I know if I've won?", "We'll contact you by phone and email straight after the draw."],
    ['Will my name be published if I win?', "Yes. We publish your first name, surname and county, and a photo with your prize if you've agreed to one, on our website and social media. You can ask us not to, but we may still have to share these details with the Advertising Standards Authority or another regulator if asked."],
    ['Do I need to verify my identity?', 'Yes. Before a prize is handed over, the winner must prove their identity, age and address.'],
    ['Is there a cash alternative?', "Some competitions offer one. If so, it's shown on the competition page."],
    ['How do I get my prize?', "We'll contact you after the draw to arrange handover."],
  ]],
];
// Every question starts closed. Each has an id so a link can open one directly, e.g. /faqs#free-entry.
const IDS: Record<string, string> = { 'Can I enter for free?': 'free-entry' };
const faqId = (q: string) => IDS[q] ?? q.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: groups.flatMap(([, items]) => items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))) };
---
<Layout title="FAQs" active="faqs">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <PageHero eyebrow="Help" title="Frequently asked questions" />
  <section class="section" style="border-bottom: 0">
    <div class="container faq" style="max-width: 960px">
      {groups.map(([cat, items]) => (
        <div class="group"><h2 class="h3" style="font-size: 22px">{cat}</h2><div>{items.map(([q, a, link]) => <details id={faqId(q)} data-faq><summary>{q}</summary><p>{a}{link ? <> <a href={link.href}>{link.label} →</a></> : null}</p></details>)}</div></div>
      ))}
      <p class="body">The full rules are in our <a href="/terms">Terms &amp; conditions</a>. Can't find your answer? <a href="/contact">Contact us</a>.</p>
    </div>
  </section>
</Layout>
<style>
  /* A linked question isn't hidden under the sticky header. */
  details[data-faq] { scroll-margin-top: 96px; }
</style>
<script>
  // Open the question the URL points at (/faqs#free-entry), and only that one. Plain /faqs: all closed.
  // A later hash link closes the question the previous one opened (questions opened by tapping stay open).
  let linked: HTMLDetailsElement | null = null;
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!(target instanceof HTMLDetailsElement) || !target.matches('[data-faq]')) return;
    if (linked && linked !== target) linked.open = false;
    linked = target;
    target.open = true;
    target.scrollIntoView({ block: 'start' });
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
<style>.group { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }</style>
