---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Responsible play">
  <PageHero eyebrow="Responsible play" title="Play responsibly" intro="Competitions should be fun. These tools help you stay in control." />
  <section class="section">
    <div class="container grid grid--4">
      <div class="tile"><h2 class="h3">Spend limits</h2><p class="small muted">Set daily, weekly or monthly limits on how much you can spend.</p><a href="/account#limits" class="btn btn--outline">Set limits</a></div>
      <div class="tile"><h2 class="h3">Take a break</h2><p class="small muted">Pause your account for 24 hours, 7 days or 30 days.</p><a href="/account#limits" class="btn btn--outline">Take a break</a></div>
      <div class="tile"><h2 class="h3">Self-exclusion</h2><p class="small muted">Close your account for 6 months or more.</p><a href="/account#limits" class="btn btn--outline">Self-exclude</a></div>
    </div>
  </section>
  <section class="section">
    <div class="container stack" style="gap: 20px">
      <h2 class="display display--s">Keep it fun</h2>
      <ul class="body"><li>Only spend what you can afford to lose.</li><li>Never chase losses or borrow money to enter.</li><li>Set a budget before you play and stick to it.</li><li>Remember you can always enter free by post.</li></ul>
    </div>
  </section>
  <section class="section">
    <div class="container stack" style="gap: 20px"><h2 class="display display--s">Under 18s</h2><p class="body">You must be 18 or over to enter. We check the age of every winner, and any prize won by someone under 18 is void.</p></div>
  </section>
  <section class="section" style="border-bottom: 0">
    <div class="container stack" style="gap: 20px">
      <h2 class="display display--s">Getting support</h2>
      <p class="body">If you're worried about how much you're spending, free confidential help is available.</p>
      <div class="rows"><div><span>National Gambling Helpline (GamCare)</span><span>0808 8020 133</span></div><div><span>GamCare</span><span><a href="https://www.gamcare.org.uk">gamcare.org.uk</a></span></div><div><span>BeGambleAware</span><span><a href="https://www.begambleaware.org">begambleaware.org</a></span></div></div>
    </div>
  </section>
</Layout>
<style>
  .tile { border: 1px solid var(--line-2); padding: 28px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .tile p { margin: 0; }
  ul { padding-left: 20px; line-height: 1.9; }
</style>
