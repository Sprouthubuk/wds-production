---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminGet, gbp, when } from '../../../lib/admin';
import type { Competition } from '../../../lib/types';
const list = (await adminGet<{ data: Competition[] }>(Astro.cookies, '/competitions')).data;
---
<AdminLayout title="Competitions" active="competitions">
  <a slot="actions" class="btn" href="/admin/competitions/new">New competition</a>
  <section class="panel">
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th></th><th>Competition</th><th>Status</th><th>Price</th><th>Sold</th><th>Draw</th><th></th></tr></thead>
      <tbody>{list.map((c) => (
        <tr>
          <td style="width:72px">{c.images[0] ? <img src={c.images[0].src} alt="" width="64" height="40" style="width:64px;height:40px;object-fit:cover" /> : null}</td>
          <td><strong>{c.title}</strong><div class="small muted">/{c.slug}</div></td>
          <td><span class={`pill pill--${c.status}`}>{c.status}</span></td>
          <td>{gbp(c.ticketPrice)}{c.bundles.length ? <div class="small muted">{c.bundles.map((b) => `${b.qty} for ${gbp(b.price)}`).join(' · ')}</div> : null}</td>
          <td><div class="bar" style="margin-bottom:6px"><span style={`width:${Math.round((c.ticketsSold / c.totalTickets) * 100)}%`}></span></div><span class="small">{c.ticketsSold} / {c.totalTickets}</span></td>
          <td class="small">{when(c.drawAt)}</td>
          <td><a class="btn btn--outline" href={`/admin/competitions/${c.id}`}>Edit</a></td>
        </tr>
      ))}</tbody>
    </table></div>
  </section>
</AdminLayout>
