---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminGet, day } from '../../lib/admin';
interface W { id: number; display_name: string; prize: string; image: string | null; verification: string; handover: string; show_on_site: boolean; drawn_at: string | null; user: { email: string; phone: string | null } | null }
const winners = await adminGet<W[]>(Astro.cookies, '/winners');
---
<AdminLayout title="Winners" active="winners">
  <section class="panel">
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th></th><th>Winner</th><th>Prize</th><th>ID check</th><th>Handover</th><th>On site</th><th></th></tr></thead>
      <tbody>{winners.map((w) => (
        <tr>
          <td style="width:64px">{w.image ? <img src={w.image} alt="" width="56" height="56" style="width:56px;height:56px;object-fit:cover" /> : <span class="muted small">No photo</span>}</td>
          <td colspan="6">
            <form class="row" style="gap:10px;align-items:center" data-admin-form={`/api/admin/winners/${w.id}`} data-method="PUT">
              <input name="displayName" value={w.display_name} style="width:160px;background:#000;border:1px solid var(--line-2);padding:7px" aria-label="Name shown on site" />
              <input name="prize" value={w.prize} style="width:200px;background:#000;border:1px solid var(--line-2);padding:7px" aria-label="Prize" />
              <select name="verification" style="background:#000;border:1px solid var(--line-2);padding:7px" aria-label="ID check">{['awaiting_id', 'to_review', 'approved', 'denied'].map((s) => <option value={s} selected={w.verification === s}>{s.replace('_', ' ')}</option>)}</select>
              <select name="handover" style="background:#000;border:1px solid var(--line-2);padding:7px" aria-label="Handover">{['not_started', 'contacted', 'booked', 'delivered'].map((s) => <option value={s} selected={w.handover === s}>{s.replace('_', ' ')}</option>)}</select>
              <label class="check small"><input type="checkbox" name="showOnSite" checked={w.show_on_site} />Show on site</label>
              <button class="btn btn--outline" type="submit">Save</button>
              <span class="small muted">{w.user ? `${w.user.email}${w.user.phone ? ` · ${w.user.phone}` : ''}` : ''} {w.drawn_at ? `· drawn ${day(w.drawn_at)}` : ''}</span>
            </form>
            <form class="row" style="gap:8px;margin-top:8px" data-admin-form={`/api/admin/winners/${w.id}/image`} data-reload>
              <input type="file" name="image" accept="image/*" required class="small" /><button class="adm-link" type="submit">Upload winner photo</button>
            </form>
          </td>
        </tr>
      ))}</tbody>
    </table></div>
  </section>
  <section class="panel">
    <h2>Add a past winner</h2>
    <form class="row" style="gap:10px" data-admin-form="/api/admin/winners" data-reload>
      <input name="displayName" placeholder="Name e.g. Mark R." required style="background:#000;border:1px solid var(--line-2);padding:9px" />
      <input name="prize" placeholder="Prize" required style="background:#000;border:1px solid var(--line-2);padding:9px" />
      <input name="drawnAt" type="date" style="background:#000;border:1px solid var(--line-2);padding:9px" />
      <label class="check small"><input type="checkbox" name="showOnSite" checked />Show on site</label>
      <button class="btn" type="submit">Add winner</button>
    </form>
    <p class="small muted" style="margin:10px 0 0">Winners from draws run here are added automatically. Only show a winner on the site once they've agreed.</p>
  </section>
</AdminLayout>
