---
// Chip sheet for a physical draw: every valid ticket number on the entry list Verity sealed at the close
// (allocated and not withdrawn), the count and the sealed fingerprint. Print it (or save as PDF) to make
// and check the numbered tokens; the CSV is the same list. Signed-in staff only (src/middleware.ts).
import '../../../../styles/global.css';
import { adminGet } from '../../../../lib/admin';
import { ApiError } from '../../../../lib/api';

interface Sheet { competition: string; reference: string; count: number; entriesHash: string; sealedAt: string | null; tickets: string[] }
const id = Number(Astro.params.id);
let sheet: Sheet | null = null;
let problem: string | null = null;
try {
  sheet = (await adminGet<{ data: Sheet }>(Astro.cookies, `/competitions/${id}/chip-sheet`)).data;
} catch (e) {
  if (e instanceof ApiError && (e.status === 422 || e.status === 404)) problem = e.message;
  else throw e;
}
const sealed = sheet?.sealedAt ? new Date(sheet.sealedAt).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' }) : null;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
  <title>{sheet ? `Chip sheet · ${sheet.competition}` : 'Chip sheet'} · WDS Admin</title>
  <link rel="icon" href="/favicon.svg" />
</head>
<body class="sheet">
  <header class="no-print bar">
    <a href="/admin/draws">← Draws</a>
    {sheet ? <span class="row" style="gap:10px"><button class="btn" type="button" data-print>Print / save as PDF</button><a class="btn btn--outline" href={`/api/admin/competitions/${id}/chip-sheet?format=csv`}>Download CSV</a></span> : null}
  </header>
  {problem ? <main class="wrap"><h1 class="h3">Chip sheet</h1><p>{problem}</p></main> : sheet ? (
    <main class="wrap">
      <h1>{sheet.competition}</h1>
      <dl class="facts">
        <div><dt>Valid tickets</dt><dd data-count>{sheet.count.toLocaleString('en-GB')}</dd></div>
        <div><dt>Draw reference</dt><dd class="mono">{sheet.reference}</dd></div>
        <div><dt>Sealed</dt><dd>{sealed ?? '—'} (UK time)</dd></div>
        <div class="wide"><dt>Sealed fingerprint (SHA-256)</dt><dd class="mono hash">{sheet.entriesHash}</dd></div>
      </dl>
      <p class="note">One token for each number below: every ticket on the entry list sealed when entries closed (online, postal and event; withdrawn entries are not on it). Count the tokens before the draw: there must be exactly {sheet.count.toLocaleString('en-GB')}.</p>
      <ol class="grid" aria-label="Valid ticket numbers">{sheet.tickets.map((t) => <li>{t}</li>)}</ol>
      <p class="note">Checked by: ______________________ &nbsp; Witness: ______________________ &nbsp; Date: ____________</p>
    </main>
  ) : null}
  <script>
    document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>
<style>
  .sheet { background: #fff; color: #000; min-height: 100vh; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 16px; background: #000; color: #fff; }
  .bar a { color: #fff; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 26px; margin: 0 0 16px; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0 0 16px; }
  .facts div { border: 1px solid #000; padding: 10px 12px; }
  .facts .wide { grid-column: 1 / -1; }
  dt { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  dd { margin: 4px 0 0; font-size: 18px; font-weight: 700; }
  .hash { font-size: 13px; word-break: break-all; font-weight: 400; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .note { font-size: 13px; margin: 0 0 16px; }
  .grid { list-style: none; margin: 0 0 20px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); border-top: 1px solid #000; border-left: 1px solid #000; }
  .grid li { border-right: 1px solid #000; border-bottom: 1px solid #000; padding: 6px 4px; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; }
  @media (max-width: 600px) { .facts { grid-template-columns: 1fr; } }
  @media print {
    .no-print { display: none !important; }
    .wrap { max-width: none; padding: 0; }
    .grid li { break-inside: avoid; }
    @page { margin: 12mm; }
  }
</style>
