---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminGet, when } from '../../lib/admin';
import ForfeitForm from '../../components/ForfeitForm.astro';

interface TrailEvent { seq: number; type: string; at: string | null; hash: string }
interface DrawState {
  competitionId: number; competition: string; verityRef: string; status: 'live' | 'paused' | 'closed' | 'drawn' | 'void' | string;
  closesAt: string | null; ticketsSold: number; totalTickets: number;
  round: number | null; roundCommitted: boolean; roundAt: string | null; roundLate: boolean; commitment: string; method: 'verity' | 'external'; drawNow: boolean;
  draw: null | { id: number; status: 'prepared' | 'drawn' | 'published' | string; entries: number; entriesHash: string; livestreamUrl: string | null; winningTicket: string | null; winnerName: string | null; drawnAt: string | null; publishedAt: string | null; certificateUrl: string | null; verifyUrl: string | null;
    winners: { id: number; label: string; ticket: string | null; name: string | null; forfeited: boolean; reason: string | null; note: string | null; canForfeit: boolean }[];
    redrawPending: { number: number; round: number; roundAt: string | null } | null };
  trail: TrailEvent[];
}
const rows = await adminGet<DrawState[]>(Astro.cookies, '/draws');
const label: Record<string, string> = {
  'competition.published': 'Published (seed committed, round planned)', 'competition.extended': 'Closing time extended', 'competition.closed_early': 'Closed early',
  'competition.closed': 'Entries closed and frozen, round committed', 'close.witnessed': 'Close timestamped', 'competition.void': 'Void (no entries)',
  'draw.completed': 'Drawn (on drand, or the external result recorded)', 'draw.winner_forfeited': 'Winner forfeited', 'draw.forfeited': 'Prize unawarded', 'draw.redraw_scheduled': 'Redraw scheduled (R2)',
  'redraw.witnessed': 'Redraw timestamped', 'draw.redrawn': 'Redrawn (R2)', 'order.withdrawn': 'Entries withdrawn (refund while open)',
};
const stateText = (r: DrawState) => r.status === 'live' ? 'Taking entries' : r.status === 'closed' ? (r.method === 'external' ? 'Sealed: record the result' : 'Closed: waiting for the drand round') : r.status === 'drawn' ? (r.draw?.status === 'published' ? 'Drawn and published' : 'Drawn: ready to publish') : r.status === 'void' ? 'Void: no entries' : r.status;
---
<AdminLayout title="Draws" active="draws">
  <section class="panel">
    <h2>How draws work</h2>
    <ol class="small" style="margin:0;padding-left:18px;line-height:1.9;color:var(--muted-2)">
      <li><strong>Publish</strong> a competition (Competitions → Publish). That locks the draw in: terms fixed, seed committed, drand round planned.</li>
      <li>At the <strong>closing time</strong> the draw engine freezes the entry list, fingerprints it and commits to a drand round still in the future. It's timestamped independently.</li>
      <li>About a minute later that round is published by drand, and the engine <strong>draws automatically</strong>. Nobody, including us, could know the result earlier.</li>
      <li><strong>Publish result</strong> when you reveal it on the Instagram live. That puts the winner and the certificate on the Live draws page.</li>
    </ol>
    <p class="small muted" style="margin:10px 0 0">No button here can change a result. A winner who forfeits is replaced by a redraw on a new future drand round (protocol R2).</p>
  </section>

  {rows.length ? rows.map((r) => (
    <section class="panel">
      <div class="row" style="justify-content:space-between;gap:12px;align-items:baseline">
        <h2 style="margin:0">{r.competition}</h2>
        <span class={`pill pill--${r.draw?.status ?? r.status}`}>{stateText(r)}</span>
      </div>
      <div class="tbl-wrap" style="margin-top:12px"><table class="tbl"><tbody>
        <tr><th>Draw reference</th><td class="mono">{r.verityRef}</td></tr>
        <tr><th>Draw method</th><td>{r.method === 'external' ? 'External draw on the livestream (Verity seals the entries)' : `Verity live draw${r.drawNow ? ' · closed with "Close & draw now"' : ''}`}</td></tr>
        {r.draw?.livestreamUrl ? <tr><th>Livestream</th><td><a href={r.draw.livestreamUrl} target="_blank" rel="noopener">{r.draw.livestreamUrl} ↗</a></td></tr> : null}
        <tr><th>Tickets</th><td>{r.ticketsSold} / {r.totalTickets}</td></tr>
        <tr><th>Closes</th><td>{when(r.closesAt)}</td></tr>
        <tr><th>drand round</th><td>{r.round ? <><span class="mono">{r.round}</span> · {r.roundCommitted ? 'committed at close' : 'planned at publish'} · expected {when(r.roundAt)}{r.roundLate ? <strong> · late close: a later round was committed</strong> : null}</> : '—'}</td></tr>
        <tr><th>Seed commitment</th><td class="mono">{r.commitment.slice(0, 24)}…</td></tr>
        {r.draw ? <tr><th>Entries frozen</th><td>{r.draw.entries} · <span class="mono">{r.draw.entriesHash.slice(0, 24)}…</span> · <a href={`/api/admin/draws/${r.draw.id}/entries.csv`}>Entry list (CSV)</a></td></tr> : null}
        {r.draw?.winningTicket ? <tr><th>Winning ticket</th><td><strong>#{r.draw.winningTicket}</strong> · {r.draw.winnerName} · drawn {when(r.draw.drawnAt)}</td></tr> : null}
        {r.draw?.verifyUrl ? <tr><th>Proof</th><td><a href={r.draw.verifyUrl} target="_blank" rel="noopener">Public verify page ↗</a> · <a href={r.draw.certificateUrl!} target="_blank" rel="noopener">Certificate (JSON) ↗</a></td></tr> : null}
      </tbody></table></div>

      {r.draw?.winners?.length ? (
        <div style="margin-top:12px">
          <h3 class="label" style="margin:0 0 6px">Winners</h3>
          <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Draw</th><th>Ticket</th><th>Winner</th><th>Status</th><th></th></tr></thead><tbody>
            {r.draw.winners.map((w) => (
              <tr>
                <td>{w.label}</td><td class="mono">#{w.ticket}</td><td>{w.name}</td>
                <td>{w.forfeited ? <><span class="pill pill--forfeited">forfeited</span><div class="small muted">{w.reason}{w.note ? ` · note: ${w.note}` : ''}</div></> : <span class="pill pill--approved">winner</span>}</td>
                <td>{w.canForfeit ? <ForfeitForm winnerId={w.id} ticket={w.ticket} name={w.name} competition={r.competition} /> : null}</td>
              </tr>
            ))}
          </tbody></table></div>
          {r.draw.redrawPending ? <p class="small" style="margin:8px 0 0">Redraw {r.draw.redrawPending.number} is committed to drand round <span class="mono">{r.draw.redrawPending.round}</span>, expected {when(r.draw.redrawPending.roundAt)}. It runs automatically.</p> : null}
        </div>
      ) : null}

      {r.status === 'live' ? (
        <div class="row" style="margin-top:12px;gap:10px;flex-wrap:wrap">
          {r.method === 'external'
            ? <button class="btn" data-admin-action={`/api/admin/competitions/${r.competitionId}/close-entries`} data-confirm={`Close entries for ${r.competition} now? Nobody can enter after this, and the entry list is sealed for your draw.`} data-reload>Close entries</button>
            : <button class="btn" data-admin-action={`/api/admin/competitions/${r.competitionId}/close-now`} data-confirm={`Close entries for ${r.competition} and draw now? The winner is drawn on the next drand round, about a minute from now.`} data-reload>Close &amp; draw now</button>}
          <span class="small muted">Press it on the livestream. Otherwise entries close at {when(r.closesAt)}.</span>
        </div>
      ) : null}

      {r.method === 'external' && r.status === 'closed' && r.draw ? (
        <form class="stack" style="margin-top:12px;gap:10px;max-width:560px" data-admin-form={`/api/admin/competitions/${r.competitionId}/external-result`} data-method="POST" data-reload
          data-confirm="Record this result? It goes on the audit chain for good and can't be changed (a winner can still forfeit and be redrawn).">
          <p class="small" style="margin:0">1. <a href={`/api/admin/draws/${r.draw.id}/entries.csv`}>Download the sealed entry list</a> ({r.draw.entries} entries, fingerprint <span class="mono">{r.draw.entriesHash.slice(0, 12)}…</span>). 2. Draw a ticket with your RNG on the livestream. 3. Record it here.</p>
          <div class="form-grid">
            <div class="field"><label for={`xt-${r.competitionId}`}>Winning ticket number</label><input id={`xt-${r.competitionId}`} name="ticket" type="number" data-type="number" min="1" max={r.totalTickets} required inputmode="numeric" /></div>
            <div class="field"><label for={`xl-${r.competitionId}`}>Livestream link</label><input id={`xl-${r.competitionId}`} name="livestreamUrl" type="url" pattern="https://.*" placeholder="https://" required /></div>
          </div>
          <button class="btn" type="submit">Record result</button>
        </form>
      ) : null}

      {r.draw?.status === 'drawn' ? (
        <div style="margin-top:12px"><button class="btn" data-admin-action={`/api/admin/draws/${r.draw.id}/publish`} data-confirm="Publish the result? It goes on the Live draws page with its certificate." data-reload>Publish result</button></div>
      ) : null}

      <details style="margin-top:12px">
        <summary class="small">Audit trail ({r.trail.length})</summary>
        <ul class="small" style="margin:8px 0 0;padding-left:18px;line-height:1.8">
          {r.trail.map((e) => <li><span class="mono">#{e.seq}</span> {label[e.type] ?? e.type} · {when(e.at)} · <span class="mono muted">{e.hash.slice(0, 12)}…</span></li>)}
        </ul>
      </details>
    </section>
  )) : (
    <section class="panel"><p class="muted">No published competitions yet. Publish one from Competitions.</p></section>
  )}
</AdminLayout>
