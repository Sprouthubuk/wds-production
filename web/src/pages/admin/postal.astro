---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminGet, localInput, when } from '../../lib/admin';
import type { Competition } from '../../lib/types';
import { ukDateTime } from '../../lib/postal';
interface Row { id: number; competition: string; name: string; email: string; receivedOn: string; receivedAt: string; status: string; reason: string | null; ticket: string | null }
const [page, comps] = await Promise.all([
  adminGet<{ data: Row[] }>(Astro.cookies, '/postal'),
  adminGet<{ data: Competition[] }>(Astro.cookies, '/postal/competitions').catch(() => ({ data: [] as Competition[] })),
]);
const nowLocal = localInput(new Date().toISOString());
// "Tuesday 22 December 2026, 6:00pm": the competition's actual postal close (its own, or 48 hours before close).
const deadline = (c: Competition) => {
  if (!c.postalClosesAt) return '';
  const [time, date] = ukDateTime(c.postalClosesAt).split(' on ');
  return `${date}, ${time}`;
};
const hint = (c?: Competition) => (c && deadline(c) ? `UK time. Must be on or before the postal deadline (${deadline(c)}).` : 'UK time. Must be on or before the postal deadline.');
---
<AdminLayout title="Postal entries" active="postal" staffOk>
  <section class="panel">
    <h2>Log a postal entry</h2>
    <p class="small muted" style="margin:0 0 14px">Type in each envelope as it arrives. Valid entries get the next ticket number straight away, in the same draw as paid entries, and the entrant is emailed. Envelopes received after the competition's postal deadline, under-18s and people over the max are rejected automatically.</p>
    <form class="stack" style="gap:14px" data-admin-form="/api/admin/postal" data-reset data-reload>
      <div class="form-grid">
        <div class="field"><label for="pc">Competition</label><select id="pc" name="competitionId" data-type="number" required data-postal-select>{comps.data.map((c) => <option value={c.id} data-hint={hint(c)}>{c.title}</option>)}</select></div>
        <div class="field"><label for="pr">Received (date and time)</label><input id="pr" name="receivedOn" type="datetime-local" data-type="uk-datetime" value={nowLocal} max={nowLocal} required /><span class="hint" data-postal-hint>{hint(comps.data[0])}</span></div>
      </div>
      <div class="form-grid">
        <div class="field"><label for="pn">Full name</label><input id="pn" name="name" required /></div>
        <div class="field"><label for="pd">Date of birth</label><input id="pd" name="dateOfBirth" type="date" required /></div>
        <div class="field"><label for="pe">Email</label><input id="pe" name="email" type="email" required /></div>
        <div class="field"><label for="pp">Phone</label><input id="pp" name="phone" /></div>
      </div>
      <div class="field"><label for="pa">Postal address</label><input id="pa" name="address" required /></div>
      <div><button class="btn" type="submit">Log entry &amp; allocate ticket</button></div>
    </form>
  </section>
  <section class="panel">
    <h2>Logged entries</h2>
    <div class="tbl-wrap"><table class="tbl">
      <thead><tr><th>Received</th><th>Name</th><th>Competition</th><th>Ticket</th><th>Status</th></tr></thead>
      <tbody>{page.data.map((e) => <tr><td class="small">{when(e.receivedAt ?? e.receivedOn)}</td><td>{e.name}<div class="small muted">{e.email}</div></td><td class="small">{e.competition}</td><td>{e.ticket ? <strong>#{e.ticket}</strong> : '—'}</td><td><span class={`pill pill--${e.status}`}>{e.status}</span>{e.reason ? <div class="small muted">{e.reason}</div> : null}</td></tr>)}</tbody>
    </table></div>
  </section>
</AdminLayout>
<script>
  const sel = document.querySelector<HTMLSelectElement>('[data-postal-select]');
  const out = document.querySelector<HTMLElement>('[data-postal-hint]');
  sel?.addEventListener('change', () => { if (out) out.textContent = sel.selectedOptions[0]?.dataset.hint ?? ''; });
</script>
