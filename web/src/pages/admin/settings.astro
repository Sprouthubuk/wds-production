---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminGet } from '../../lib/admin';
import type { SiteSettings } from '../../lib/types';
const s = (await adminGet<{ data: SiteSettings }>(Astro.cookies, '/settings')).data;
---
<AdminLayout title="Settings" active="settings">
  <form class="stack" style="gap:20px;max-width:860px" data-admin-form="/api/admin/settings" data-method="PUT" data-settings>
    <section class="panel">
      <h2>Business details</h2>
      <p class="small muted" style="margin:0 0 14px">Shown in the footer, terms and emails.</p>
      <div class="form-grid">
        <div class="field"><label for="tn">Trading name</label><input id="tn" name="tradingName" value={s.tradingName} /></div>
        <div class="field"><label for="ln">Company name</label><input id="ln" name="legalName" value={s.legalName} /></div>
        <div class="field"><label for="cn">Company number</label><input id="cn" name="companyNumber" value={s.companyNumber} /></div>
        <div class="field"><label for="se">Contact email</label><input id="se" type="email" value={s.supportEmail} readonly aria-describedby="se-h" /><span class="hint" id="se-h">Set on the server (CONTACT_EMAIL). Contact form messages go here.</span></div>
      </div>
      <div class="field" style="margin-top:14px"><label for="ro">Registered office</label><input id="ro" name="registeredOffice" value={s.registeredOffice} /></div>
    </section>
    <section class="panel">
      <h2>Scrolling banner messages</h2>
      <div class="field"><label for="bm">Messages (one per line)</label><textarea id="bm" name="bannerMessages" data-type="lines" rows="5" placeholder={"Ticket bundles available\nLow ticket numbers, better odds"} aria-describedby="bm-h">{(s.bannerMessages ?? []).join('\n')}</textarea><span class="hint" id="bm-h">Scroll in a loop under the header on the home page, in this order. Leave empty for no banner.</span></div>
    </section>
    <section class="panel">
      <h2>Free postal entry</h2>
      <div class="field"><label for="pa">Postal entry address (one line per row)</label><textarea id="pa" name="postalEntryAddress" data-type="lines" rows="7">{s.postalEntryAddress.join('\n')}</textarea><span class="hint">Shown on the Free Postal Entry page.</span></div>
    </section>
    <section class="panel">
      <h2>Live draws</h2>
      <div class="form-grid">
        <div class="field"><label for="ig">Instagram for live draws</label><input id="ig" name="drawsInstagram" value={s.drawsInstagram} /><span class="hint">Without the @</span></div>
        <div class="field"><label for="dyt">YouTube for live draws (optional)</label><input id="dyt" name="drawsYoutubeUrl" type="url" placeholder="https://youtube.com/@…" value={s.drawsYoutubeUrl ?? ''} /><span class="hint">When set, the site says "Drawn live on our socials". Instagram stays the main link.</span></div>
      </div>
    </section>
    <section class="panel">
      <h2>Social links</h2>
      <p class="small muted" style="margin:0 0 14px">Shown as icon + label in the footer and on the Contact page, in this order. Leave a link empty to hide it.</p>
      <div class="form-grid" style="margin-bottom:10px">
        <div class="field"><label for="socialInstagramOriginals-l">Instagram 1: label</label><input id="socialInstagramOriginals-l" name="socialInstagramOriginalsLabel" maxlength="40" value={s.socialInstagramOriginalsLabel ?? ''} placeholder="@wds_originals" /></div>
        <div class="field"><label for="socialInstagramOriginals-u">Instagram 1: link</label><input id="socialInstagramOriginals-u" name="socialInstagramOriginalsUrl" type="url" value={s.socialInstagramOriginalsUrl ?? ''} placeholder="https://www.instagram.com/wds_originals/" /></div>
      </div>
      <div class="form-grid" style="margin-bottom:10px">
        <div class="field"><label for="socialYoutube-l">YouTube: label</label><input id="socialYoutube-l" name="socialYoutubeLabel" maxlength="40" value={s.socialYoutubeLabel ?? ''} placeholder="@wds_originals" /></div>
        <div class="field"><label for="socialYoutube-u">YouTube: link</label><input id="socialYoutube-u" name="socialYoutubeUrl" type="url" value={s.socialYoutubeUrl ?? ''} placeholder="https://www.youtube.com/@wds_originals" /></div>
      </div>
      <div class="form-grid" style="margin-bottom:10px">
        <div class="field"><label for="socialInstagramCompetitions-l">Instagram 2: label</label><input id="socialInstagramCompetitions-l" name="socialInstagramCompetitionsLabel" maxlength="40" value={s.socialInstagramCompetitionsLabel ?? ''} placeholder="@wds_competitions" /></div>
        <div class="field"><label for="socialInstagramCompetitions-u">Instagram 2: link</label><input id="socialInstagramCompetitions-u" name="socialInstagramCompetitionsUrl" type="url" value={s.socialInstagramCompetitionsUrl ?? ''} placeholder="https://www.instagram.com/wds_competitions/" /></div>
      </div>
      <div class="form-grid" style="margin-bottom:10px">
        <div class="field"><label for="socialFacebook-l">Facebook: label</label><input id="socialFacebook-l" name="socialFacebookLabel" maxlength="40" value={s.socialFacebookLabel ?? ''} placeholder="Facebook" /></div>
        <div class="field"><label for="socialFacebook-u">Facebook: link</label><input id="socialFacebook-u" name="socialFacebookUrl" type="url" value={s.socialFacebookUrl ?? ''} placeholder="https://www.facebook.com/…" /></div>
      </div>
      <span class="hint">The Instagram account named in live-draw copy is set under Live draws, not here.</span>
    </section>
    <section class="panel">
      <h2>Site-wide monthly spend cap</h2>
      <p class="small muted" style="margin:0 0 14px">Optional, and off unless the client decides to use it. When on, no customer (account or email) can spend more than this in a calendar month across all competitions, online and at events, whatever their own limits say. Customers' own limits and the £250 credit card cap always apply.</p>
      <div class="form-grid">
        <label class="check" for="scap-on"><input id="scap-on" name="siteSpendCapEnabled" type="checkbox" checked={!!s.siteSpendCapEnabled} />Turn the site-wide cap on</label>
        <div class="field"><label for="scap">Monthly cap per customer (£)</label><input id="scap" name="siteSpendCapMonthly" data-type="number" type="number" min="1" step="1" value={s.siteSpendCapMonthly ?? ''} placeholder="e.g. 500" /></div>
      </div>
    </section>
    <div><button class="btn" type="submit">Save settings</button></div>
  </form>
</AdminLayout>
