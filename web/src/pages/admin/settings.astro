---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminGet } from '../../lib/admin';
import type { SiteSettings } from '../../lib/types';
const s = (await adminGet<{ data: SiteSettings }>(Astro.cookies, '/settings')).data;
---
<AdminLayout title="Settings" active="settings">
  <form class="stack" style="gap:20px;max-width:860px" data-admin-form="/api/admin/settings" data-method="PUT" data-settings>
    <section class="panel">
      <h2>Business details</h2>
      <p class="small muted" style="margin:0 0 14px">Shown in the footer, terms and emails.</p>
      <div class="form-grid">
        <div class="field"><label for="tn">Trading name</label><input id="tn" name="tradingName" value={s.tradingName} /></div>
        <div class="field"><label for="ln">Company name</label><input id="ln" name="legalName" value={s.legalName} /></div>
        <div class="field"><label for="cn">Company number</label><input id="cn" name="companyNumber" value={s.companyNumber} /></div>
        <div class="field"><label for="se">Support email</label><input id="se" name="supportEmail" type="email" value={s.supportEmail} /></div>
      </div>
      <div class="field" style="margin-top:14px"><label for="ro">Registered office</label><input id="ro" name="registeredOffice" value={s.registeredOffice} /></div>
    </section>
    <section class="panel">
      <h2>Free postal entry</h2>
      <div class="field"><label for="pa">Postal entry address (one line per row)</label><textarea id="pa" name="postalEntryAddress" data-type="lines" rows="7">{s.postalEntryAddress.join('\n')}</textarea><span class="hint">Shown on the Free Postal Entry page.</span></div>
    </section>
    <section class="panel">
      <h2>Live draws &amp; socials</h2>
      <div class="form-grid">
        <div class="field"><label for="ig">Instagram for live draws</label><input id="ig" name="drawsInstagram" value={s.drawsInstagram} /><span class="hint">Without the @</span></div>
        <div class="field"><label for="dyt">YouTube for live draws (optional)</label><input id="dyt" name="drawsYoutubeUrl" type="url" placeholder="https://youtube.com/@…" value={s.drawsYoutubeUrl ?? ''} /><span class="hint">When set, the site says "Drawn live on our socials". Instagram stays the main link.</span></div>
        <div class="field"><label for="yt">YouTube channel (builds)</label><input id="yt" name="youtubeUrl" type="url" value={s.youtubeUrl} /><span class="hint">The WDS Originals channel in the footer and About page.</span></div>
      </div>
    </section>
    <section class="panel">
      <h2>Site-wide monthly spend cap</h2>
      <p class="small muted" style="margin:0 0 14px">Optional, and off unless the client decides to use it. When on, no customer (account or email) can spend more than this in a calendar month across all competitions, online and at events, whatever their own limits say. Customers' own limits and the £250 credit card cap always apply.</p>
      <div class="form-grid">
        <label class="check" for="scap-on"><input id="scap-on" name="siteSpendCapEnabled" type="checkbox" checked={!!s.siteSpendCapEnabled} />Turn the site-wide cap on</label>
        <div class="field"><label for="scap">Monthly cap per customer (£)</label><input id="scap" name="siteSpendCapMonthly" data-type="number" type="number" min="1" step="1" value={s.siteSpendCapMonthly ?? ''} placeholder="e.g. 500" /></div>
      </div>
    </section>
    <div><button class="btn" type="submit">Save settings</button></div>
  </form>
</AdminLayout>
