---
import { drawChannels } from '../lib/channels';
import LegalPage from '../components/LegalPage.astro';
import { getSettings } from '../lib/api';
const s = await getSettings();
const ch = drawChannels(s);   // YouTube is named only when drawsYoutubeUrl is set; the handle comes from Settings
const sections: [string, string[]][] = [
  ['The promoter', [`The promoter is ${s.legalName} (company no. ${s.companyNumber}), trading as ${s.tradingName}, of ${s.registeredOffice}.`]],
  ['Who can enter', [`Anyone aged 18 or over who lives in the UK. Employees and contractors of ${s.legalName}, their immediate families and households, and anyone professionally connected with running the competitions can't enter.`]],
  ["Age and identity checks", ["You must be 18 or over to enter. We may ask any entrant to prove their age and identity at any time. Entries made by anyone under 18 or otherwise not eligible are void and refunded to the payer."]],
  ['How to enter', ['You can enter a paid competition online by buying tickets, or free by post. Both routes have equal standing and the same chance of winning. Free competitions are entered online only, one entry per verified account, and have no postal route.', 'Skill question: to enter a paid competition online you must answer a multiple-choice question correctly before you pay. If your answer is wrong you cannot continue to payment and nothing is charged; you may try again. The question is shown in the basket and is fixed when the competition is published.', 'Free entry route: every paid competition can also be entered free by post. The address and what to include are on the <a href="/free-postal-entry">free postal entry page</a>. Postal entries:', "<ul><li>One entry per envelope, sent by post with the correct stamp. Envelopes containing more than one entry count as one entry.</li><li>Hand-delivered, bulk, mass-produced or third-party entries (entries sent on someone else's behalf) aren't accepted.</li><li>If a competition has a maximum per person, online and postal entries count towards the same limit.</li><li>Entries must arrive by the postal deadline shown on the competition: at least 48 hours before it closes, unless the competition page says otherwise.</li></ul>"]],
  ['Payment', ["Payment is by debit card, including Apple Pay or Google Pay using a debit card. Credit cards aren't accepted."]],
  ['Entries and limits', ['Each competition has a fixed maximum number of entries, shown on its page. Where a competition states a maximum per person, each person may make up to that maximum across online and postal routes combined. Ticket numbers are issued in sequence.']],
  ["Your entry", ["Ticket numbers are issued in sequence once your payment is confirmed or your postal entry is processed. Our records of entries and ticket numbers are final. Entries aren't transferable.", "Your entry is completed as soon as your ticket numbers are issued. When you pay, you ask us to issue your tickets straight away and you agree that, once they're issued, you can't cancel the entry or get a refund except as set out in our <a href=\"/refunds\">refunds policy</a>. This doesn't affect your statutory rights."]],
  ['Bundles and pricing', ['Bundles are offered at fixed prices. The price charged is the cheapest combination of single tickets and bundles for the number of tickets selected.']],
  ['Closing dates', ['Each competition closes at the date and time shown, or earlier if all entries are allocated. The draw goes ahead on the stated date and time regardless of how many tickets have sold. Closing dates are not extended, except as set out under Cancellation and changes.']],
  ['The draw', [`The winner is drawn at random from all valid entries (online, postal and event), live on ${ch.youtube && ch.instagram ? `our socials (Instagram @${ch.instagram.handle} and YouTube)` : ch.where}, using the method stated on the competition page. The entry list is locked when the competition closes, and each result is published at <a href="/verify">/verify</a>.`]],
  ['Winners', ["We'll contact the winner by phone and email after the draw. Before a prize is released, the winner must prove their identity, age and address (for example photo ID and a recent proof of address) and must be the person named on the winning account or postal entry. If the winner isn't eligible, doesn't respond within 14 days of the draw, or doesn't complete these checks, the prize is forfeited and redrawn from the remaining valid entries.", "If you win, we'll publish your first name, surname and county, and a photo of you with your prize where you've agreed to one, on our website and social media. You can ask us not to publish your name or photo; if you do, we may still have to share these details with the Advertising Standards Authority or another regulator if asked."]],
  ["Prizes", ["Prizes are as described on each competition page. Prizes can't be transferred or exchanged, except for the cash alternative where one is offered. Where a cash alternative is offered, the winner may choose it instead of the prize, and we'll pay it by bank transfer within 14 days of the winner choosing it and completing our checks.", "Vehicle prizes are provided in the condition described on the competition page. We'll provide the V5C so the winner can register the vehicle in their name. The winner is responsible for insurance, road tax and registration, and anyone driving the vehicle away must hold a valid licence and insurance. Vehicle prizes are collected from our premises in Surrey within 30 days of the winner completing our checks, or delivered by arrangement.", "Other prizes are delivered to the winner's UK address at our cost, or collected by arrangement."]],
  ["Cancellation and changes", ["We may postpone, change or cancel a competition if circumstances outside our reasonable control make it impossible or impractical to run it as described, for example if the prize is stolen, destroyed or seriously damaged, a technical failure affects the integrity of the entries, or a change in law or regulatory guidance requires it. If we postpone a draw, we'll show the new date on the competition page and email entrants. If we cancel a competition, we'll refund all paid entries in full and no draw will take place. If a prize becomes unavailable for reasons outside our control, we may replace it with a prize of equal or greater value."]],
  ["Disqualification", ["We may disqualify entries and refuse to award a prize if we reasonably believe an entrant has broken these terms, given false details, used more than one account or identity to get around a limit, used automated means to enter, or acted fraudulently. If a payment is reversed or charged back, the tickets bought with it are void. Entries made while a self-exclusion or account break is in place are void and refunded."]],
  ['Refunds and cancellations', ['When entries are refunded is set out in our <a href="/refunds">refunds policy</a>.']],
  ['Your data', ['We use your details to run the competition and contact winners, as set out in our <a href="/privacy">privacy policy</a>.']],
  ["Our liability", ["Nothing in these terms limits or excludes our liability for death or personal injury caused by our negligence, for fraud or fraudulent misrepresentation, or for anything else that can't be limited or excluded by law.", "Subject to that, we aren't liable for: any loss that wasn't reasonably foreseeable when you entered; entries that are lost, delayed, incomplete or not received, including postal entries and entries affected by internet, payment or technical problems outside our reasonable control; or any loss arising from your use of a prize after it has been handed over to you.", "Subject to the first paragraph, our total liability to you in connection with a competition is limited to the amount you paid for entries in that competition or, if you are the verified winner, the value of the prize (or the cash alternative, where offered). This doesn't affect your statutory rights."]],
  ["Changes to these terms", ["We may update these terms from time to time. The version in force when you enter a competition applies to that entry. Once a competition is published we won't change its closing date, number of tickets, price or maximum per person, except as set out under Cancellation and changes."]],
  ["Decisions", ["If something happens that these terms don't cover, we'll decide what's fair, acting reasonably. Our decisions on eligibility and on running the competitions are final, as far as the law allows."]],
  ["Governing law", ["These terms are governed by the laws of England and Wales. You can bring proceedings in the courts of England and Wales, or, if you live in Scotland or Northern Ireland, in the courts where you live."]],
  ['Company details', [`${s.legalName}, trading as ${s.tradingName}.`, `Registered in England &amp; Wales, company no. ${s.companyNumber}.`, `Registered office: ${s.registeredOffice}.`, `Email: <a href="mailto:${s.supportEmail}">${s.supportEmail}</a>`]],
];
---
<LegalPage title="Terms & conditions" heading="Terms & conditions" sections={sections} updated="20 November 2026" />
