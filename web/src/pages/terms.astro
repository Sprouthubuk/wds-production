---
import { drawChannels } from '../lib/channels';
import LegalPage from '../components/LegalPage.astro';
import { getSettings } from '../lib/api';
const s = await getSettings();
const ch = drawChannels(s);   // YouTube is named only when drawsYoutubeUrl is set; the handle comes from Settings
const sections: [string, string[]][] = [
  ['The promoter', [`The promoter is ${s.legalName} (company no. ${s.companyNumber}), trading as ${s.tradingName}, of ${s.registeredOffice}.`]],
  ['Who can enter', ['Entry is open to UK residents aged 18 or over. [List any exclusions, e.g. employees of the promoter and their households.]']],
  ['How to enter', ['You can enter a paid competition online by buying tickets, or free by post. Both routes have equal standing and the same chance of winning. Free competitions are entered online only, one entry per verified account, and have no postal route.', 'Free postal entries must follow the instructions on the <a href="/free-postal-entry">free postal entry page</a> and must be received at least 48 hours before the competition closes (or by the postal deadline shown on the competition page).']],
  ['Entries and limits', ['Each competition has a fixed maximum number of entries, shown on its page. Where a competition states a maximum per person, each person may make up to that maximum across online and postal routes combined. Ticket numbers are issued in sequence.']],
  ['Bundles and pricing', ['Bundles are offered at fixed prices. The price charged is the cheapest combination of single tickets and bundles for the number of tickets selected.']],
  ['Closing dates', ['Each competition closes at the date and time shown, or earlier if all entries are allocated. The draw goes ahead on the stated date and time regardless of how many tickets have sold. Closing dates are not extended.']],
  ['The draw', [`The winner will be selected at random from all valid entries (online, postal and event), using the draw method stated on the competition page: either a Verity draw or an external random number generator shown on a live stream. Full draw records can be checked at <a href="/verify">/verify</a>. Draws are streamed live on ${ch.youtube && ch.instagram ? `our socials (Instagram @${ch.instagram.handle} and YouTube)` : ch.where} and results are published on the site.`]],
  ['Winners', ['We will contact the winner by phone and email after the draw. Winners must verify their identity and age before a prize is released. [State how long a winner has to respond before a redraw.]']],
  ['Prizes', ['Prizes are as described on each competition page. [Cash alternative terms.] [Collection or delivery terms for vehicles.]']],
  ['Refunds and cancellations', ['[Refund policy, including what happens if a competition is cancelled.]']],
  ['Our liability', ['[Limitation of liability wording.]']],
  ['Your data', ['We use your details to run the competition and contact winners, as set out in our <a href="/privacy">privacy policy</a>.']],
  ['Governing law', ['These terms are governed by the laws of England and Wales. [Confirm.]']],
];
---
<LegalPage title="Terms & conditions" heading="Terms & conditions" sections={sections} />
