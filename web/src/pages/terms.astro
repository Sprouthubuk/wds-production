---
import { drawChannels } from '../lib/channels';
import LegalPage from '../components/LegalPage.astro';
import { getSettings } from '../lib/api';
const s = await getSettings();
const ch = drawChannels(s);   // YouTube is named only when drawsYoutubeUrl is set; the handle comes from Settings
const sections: [string, string[]][] = [
  ['The promoter', [`The promoter is ${s.legalName} (company no. ${s.companyNumber}), trading as ${s.tradingName}, of ${s.registeredOffice}.`]],
  ['Who can enter', [`Anyone aged 18 or over who lives in the UK. Employees and contractors of ${s.legalName}, their immediate families and households, and anyone professionally connected with running the competitions can't enter.`]],
  ['How to enter', ['You can enter a paid competition online by buying tickets, or free by post. Both routes have equal standing and the same chance of winning. Free competitions are entered online only, one entry per verified account, and have no postal route.', 'Skill question: to enter a paid competition online you must answer a multiple-choice question correctly before you pay. If your answer is wrong you cannot continue to payment and nothing is charged; you may try again. The question is shown in the basket and is fixed when the competition is published.', 'Free entry route: every paid competition can also be entered free by post. The address and what to include are on the <a href="/free-postal-entry">free postal entry page</a>. Postal entries:', "<ul><li>One entry per envelope, sent by post with the correct stamp. Envelopes containing more than one entry count as one entry.</li><li>Hand-delivered, bulk, mass-produced or third-party entries (entries sent on someone else's behalf) aren't accepted.</li><li>If a competition has a maximum per person, online and postal entries count towards the same limit.</li><li>Entries must arrive by the postal deadline shown on the competition: at least 48 hours before it closes, unless the competition page says otherwise.</li></ul>"]],
  ['Payment', ["Payment is by debit card, including Apple Pay or Google Pay using a debit card. Credit cards aren't accepted."]],
  ['Entries and limits', ['Each competition has a fixed maximum number of entries, shown on its page. Where a competition states a maximum per person, each person may make up to that maximum across online and postal routes combined. Ticket numbers are issued in sequence.']],
  ['Bundles and pricing', ['Bundles are offered at fixed prices. The price charged is the cheapest combination of single tickets and bundles for the number of tickets selected.']],
  ['Closing dates', ['Each competition closes at the date and time shown, or earlier if all entries are allocated. The draw goes ahead on the stated date and time regardless of how many tickets have sold. Closing dates are not extended.']],
  ['The draw', [`The winner is drawn at random from all valid entries (online, postal and event), live on ${ch.youtube && ch.instagram ? `our socials (Instagram @${ch.instagram.handle} and YouTube)` : ch.where}, using the method stated on the competition page. The entry list is locked when the competition closes, and each result is published at <a href="/verify">/verify</a>.`]],
  ['Winners', ['We will contact the winner by phone and email after the draw. Winners must verify their identity and age before a prize is released. A winner has 14 days from the draw to respond and complete these checks, or the prize may be forfeited and redrawn.', "If you win, we'll publish your first name, surname and county, and a photo of you with your prize where you've agreed to one, on our website and social media. You can ask us not to publish your name or photo; if you do, we may still have to share these details with the Advertising Standards Authority or another regulator if asked."]],
  ['Prizes', ['Prizes are as described on each competition page. Where a competition offers a cash alternative, the amount is shown on its page and the winner may choose it instead of the prize. We arrange the handover of the prize with the winner.']],
  ['Refunds and cancellations', ['When entries are refunded is set out in our <a href="/refunds">refunds policy</a>.']],
  ['Your data', ['We use your details to run the competition and contact winners, as set out in our <a href="/privacy">privacy policy</a>.']],
  ['Governing law', ['These terms are governed by the laws of England and Wales.']],
  ['Company details', [`${s.legalName}, trading as ${s.tradingName}.`, `Registered in England &amp; Wales, company no. ${s.companyNumber}.`, `Registered office: ${s.registeredOffice}.`, `Email: <a href="mailto:${s.supportEmail}">${s.supportEmail}</a>`]],
];
---
<LegalPage title="Terms & conditions" heading="Terms & conditions" sections={sections} />
