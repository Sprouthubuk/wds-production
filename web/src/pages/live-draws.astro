---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getDraws, getSettings } from '../lib/api';
const [draws, settings] = await Promise.all([getDraws(), getSettings()]);
const fmt = (iso: string) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/London' }) : '—');
const upcoming = draws.filter((d) => !d.winningTicket && !d.winner);
---
<Layout title="Live draws & results">
  <PageHero eyebrow="Live draws" title="Live draws & results" intro={`Every winner is drawn live on Instagram @${settings.drawsInstagram}. Results and draw certificates are published here.`} />
  <section class="section">
    <div class="container row" style="gap: 40px; align-items: flex-start">
      <div class="live-box">
        <span class="label">Next live draw</span>
        <h2 class="display display--s">{upcoming[0] ? `${upcoming[0].competition}` : 'Coming soon'}</h2>
        {upcoming[0] ? <p class="lead">{new Date(upcoming[0].drawAt).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' })}</p> : null}
        <a href={`https://instagram.com/${settings.drawsInstagram}`} class="btn">Watch live on Instagram @{settings.drawsInstagram}</a>
        <span class="small muted">Turn on post notifications so you don't miss your number.</span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container stack" style="gap: 24px">
      <h2 class="display display--s">Draw results</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Competition</th><th scope="col">Draw date</th><th scope="col">Winning ticket</th><th scope="col">Winner</th><th scope="col">Certificate</th></tr></thead>
          <tbody>
            {draws.map((d) => (
              <tr><td><strong>{d.competition}</strong></td><td>{fmt(d.drawAt)}</td><td>{d.winningTicket ?? (d.winner ? '—' : 'Upcoming')}</td><td>{d.winner ?? '—'}</td><td>{d.certificateUrl ? <a href={d.certificateUrl}>View</a> : '—'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section" style="border-bottom: 0">
    <div class="container">
      <div class="section-head"><h2 class="display display--s">How our draws work</h2></div>
      <div class="grid grid--4">
        <div class="tile"><h3 class="h3">Every entry included</h3><p class="small muted">Online, postal and event entries share one run of ticket numbers.</p></div>
        <div class="tile"><h3 class="h3">Random and verified</h3><p class="small muted">The winning number is generated by the Verity draw engine, live on stream.</p></div>
        <div class="tile"><h3 class="h3">Published results</h3><p class="small muted">Each result is published here with its draw certificate.</p></div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .live-box { flex: 1 1 520px; border: 1px solid #fff; padding: 36px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line-2); }
  table { width: 100%; min-width: 720px; border-collapse: collapse; }
  th { text-align: left; padding: 14px 16px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line-3); }
  td { padding: 18px 16px; border-bottom: 1px solid var(--line); font-size: 15px; }
  .tile { border: 1px solid var(--line-2); padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .tile p { margin: 0; }
</style>
