---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getDraws, getSettings } from '../lib/api';
import { drawChannels } from '../lib/channels';
const [draws, settings] = await Promise.all([getDraws(), getSettings()]);
const ch = drawChannels(settings);
const fmt = (iso: string) => (iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/London' }) : '—');
const upcoming = draws.filter((d) => !d.winningTicket && !d.winner);
---
<Layout title="Live draws & results">
  <PageHero eyebrow="Live draws" title="Live draws & results" intro={`Every winner is drawn live on ${ch.where}. Results and draw certificates are published here.`} />
  <section class="section">
    <div class="container row" style="gap: 40px; align-items: flex-start">
      <div class="live-box" data-reveal>
        <span class="label">Next live draw</span>
        <h2 class="display display--s">{upcoming[0] ? `${upcoming[0].competition}` : 'Coming soon'}</h2>
        {upcoming[0] ? <p class="lead">{new Date(upcoming[0].drawAt).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' })}</p> : null}
        <div class="row" style="gap: 10px">
          {ch.instagram ? <a href={ch.instagram.url} class="btn">Watch on Instagram</a> : null}
          {ch.youtube ? <a href={ch.youtube.url} class={ch.instagram ? 'btn btn--outline' : 'btn'}>Watch on YouTube</a> : null}
        </div>
        <span class="small muted">Turn on post notifications so you don't miss your number.</span>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container stack" style="gap: 24px">
      <h2 class="display display--s">Draw results</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Competition</th><th scope="col">Draw date</th><th scope="col">Winning ticket</th><th scope="col">Winner</th><th scope="col">Proof</th></tr></thead>
          <tbody>
            {draws.map((d) => (
              <tr><td data-label="Competition"><strong>{d.competition}</strong></td><td data-label="Draw date">{fmt(d.drawAt)}</td><td data-label="Winning ticket">{d.winningTicket ?? (d.winner ? '—' : 'Upcoming')}</td><td data-label="Winner">{d.winner ?? d.note ?? '—'}{d.redraws ? <span class="small muted"> (redraw {d.redraws})</span> : null}</td><td data-label="Proof">{d.id && d.verifyUrl ? <a href={`/verify/${d.id}`}>Verify the draw</a> : '—'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section" style="border-bottom: 0">
    <div class="container">
      <div class="section-head"><h2 class="display display--s">How our draws work</h2></div>
      <div class="grid grid--4" data-reveal-group>
        <div class="tile"><h3 class="h3">Every entry included</h3><p class="small muted">Online, postal and event entries share one run of ticket numbers.</p></div>
        <div class="tile"><h3 class="h3">Locked in at launch</h3><p class="small muted">When a competition goes live its terms are fixed. For a Verity draw, the engine also commits to a secret seed and to the public drand round at the live draw time.</p></div>
        <div class="tile"><h3 class="h3">Sealed, then drawn</h3><p class="small muted">Entries are sealed and fingerprinted when they close. A Verity draw takes the winner from that drand round, which nobody, including us, can know in advance. An external draw is made live on the linked livestream, from the sealed list.</p></div>
        <div class="tile"><h3 class="h3">Check it yourself</h3><p class="small muted">Each result links to a page that re-checks the draw in your browser: the sealed entries, the whole pick for a Verity draw, and that an external draw's winning ticket was on the sealed list.</p></div>
      </div>
    </div>
  </section>
</Layout>
<style>
  .live-box { flex: 1 1 520px; border: 1px solid #fff; padding: 36px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line-2); }
  table { width: 100%; min-width: 720px; border-collapse: collapse; }
  th { text-align: left; padding: 14px 16px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line-3); }
  td { padding: 18px 16px; border-bottom: 1px solid var(--line); font-size: 15px; }
  .tile { border: 1px solid var(--line-2); padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .tile p { margin: 0; }
  @media (max-width: 700px) {
    .live-box { padding: 24px; }
    .table-wrap { border: 0; overflow: visible; }
    table, tbody, tr, td { display: block; min-width: 0; }
    thead { display: none; }
    tr { border: 1px solid var(--line-2); padding: 6px 18px; margin-bottom: 10px; }
    td { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; text-align: right; }
    td:last-child { border-bottom: 0; }
    td::before { content: attr(data-label); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); text-align: left; }
    td:first-child { display: block; text-align: left; font-size: 17px; }
    td:first-child::before { display: none; }
  }
</style>
