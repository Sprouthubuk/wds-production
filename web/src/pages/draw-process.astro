---
import LegalPage from '../components/LegalPage.astro';
const sections: [string, string[]][] = [
  ['Locking the entries', ["When a competition closes, the entry list is locked and can't be changed. Online, postal and event entries are all on it."]],
  ['The live draw', ['We draw the winning number live on Instagram from numbered chips, one for every ticket.']],
  ['If a winner forfeits', ["If a winner doesn't respond within 14 days or fails the ID check, the prize is redrawn and the new result is published."]],
  ['Checking a draw yourself', ['Every result is recorded on <a href="/verify">Verify a draw</a>, so anyone can check the winning ticket was a genuine entry.']],
];
---
<LegalPage title={'Draw process'} heading={'Draw process'} sections={sections} />
