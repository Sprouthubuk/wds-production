---
import { drawChannels } from '../lib/channels';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getSettings } from '../lib/api';
import { prelaunchState } from '../lib/prelaunch';
const [settings, pre] = await Promise.all([getSettings(), prelaunchState(Astro.locals)]);
const journey = [
  ['01', 'Entries open', 'Each competition has a fixed, low number of tickets, shown on the page, so you always know your odds.'],
  ['02', 'Numbers issued in order', 'Online, postal and event entries get the next ticket numbers in sequence from one run.'],
  ['03', 'Competition closes', 'Entries close at the advertised date and time, or when every ticket is gone.'],
  ['04', 'Live draw', `The winning number is drawn live on ${drawChannels(settings).where} from the sealed entry list, and the result is published with a certificate anyone can check.`],
  ['05', 'Winner verified', 'We contact the winner, check their ID and arrange handover of the prize.'],
];
const fair = [
  ['Better odds', 'Low ticket numbers on every competition.'],
  ['Instant numbers', 'Your ticket numbers are emailed as soon as you check out.'],
  ['Verified draws', 'Every draw is streamed live and the result published with a certificate.'],
  ['18+ only', 'All entrants and winners must be 18 or over and UK residents.'],
];
---
<Layout title="How it works">
  <PageHero eyebrow="How it works" title="How WDS Competitions works" intro="Pick a prize, choose your tickets and watch the winner drawn live." />
  <section class="section">
    <div class="container">
      <div class="section-head"><h2 class="display display--s">Enter in three steps</h2></div>
      <ol class="steps">
        <li><b>01</b><span>Choose your tickets or a bundle</span></li>
        <li><b>02</b><span>Answer the question and check out securely</span></li>
        <li><b>03</b><span>Your numbers are emailed instantly</span></li>
      </ol>
      <div class="steps-cta">{pre.on ? <a href={pre.href} class="btn">Get first access</a> : <a href="/competitions" class="btn">View competitions</a>}</div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><h2 class="display display--s">From entry to winner</h2></div>
      <div class="journey">{journey.map(([n, t, d]) => <div><b>{n}</b><div class="stack" style="gap: 8px"><h3 class="h3">{t}</h3><p class="body muted">{d}</p></div></div>)}</div>
    </div>
  </section>
  <section class="section" style="border-bottom: 0">
    <div class="container">
      <div class="section-head"><h2 class="display display--s">Fair and transparent</h2></div>
      <div class="grid grid--4">{fair.map(([t, d]) => <div class="tile"><h3 class="h3" style="font-size: 16px">{t}</h3><p class="small muted">{d}</p></div>)}</div>
    </div>
  </section>
</Layout>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .steps li { display: flex; flex-direction: column; gap: 10px; padding: 24px 24px 24px 0; font-size: 16px; color: #d0d0d0; }
  .steps li + li { padding-left: 24px; border-left: 1px solid var(--line-2); }
  .steps b { font-size: 32px; line-height: 1; color: #fff; }
  .steps-cta { margin-top: 28px; }
  @media (max-width: 700px) {
    .steps { grid-template-columns: minmax(0, 1fr); }
    .steps li, .steps li + li { flex-direction: row; align-items: center; gap: 16px; padding: 16px 0; border-left: 0; border-bottom: 1px solid var(--line-2); font-size: 15px; }
    .steps b { font-size: 22px; min-width: 32px; }
    .steps-cta .btn { width: 100%; }
  }
  .journey > div { display: flex; gap: 32px; padding: 26px 0; border-top: 1px solid var(--line-2); }
  .journey b { flex: 0 0 72px; font-size: 40px; line-height: 1; color: #5c5c5c; }
  .journey p { margin: 0; }
  .tile { border: 1px solid var(--line-2); padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .tile p { margin: 0; }
</style>
