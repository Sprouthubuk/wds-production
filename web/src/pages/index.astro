---
import { thumb } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import EntryPanel from '../components/EntryPanel.astro';
import CompetitionCard from '../components/CompetitionCard.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import LaunchHero from '../components/LaunchHero.astro';
import LaunchCard from '../components/LaunchCard.astro';
import SignupForm from '../components/SignupForm.astro';
import Ticker from '../components/Ticker.astro';
import { getCompetitions, getSettings, getUpcoming, getWinners } from '../lib/api';
import { money, odds, percentSold } from '../lib/pricing';
import { countdownParts } from '../lib/countdown';
import { drawChannels } from '../lib/channels';
import { launchCountdown } from '../lib/prelaunch';
import { isComingSoon, launchDay, nextOpening } from '../lib/coming-soon';
import { getAllowance } from '../lib/allowance';
import type { CompetitionTeaser } from '../lib/types';

const [competitions, settings, winners, upcoming] = await Promise.all([getCompetitions(), getSettings(), getWinners(), getUpcoming()]);
const ch = drawChannels(settings);
// Pre-launch: nothing is live. The hero says "Launching 1st December" with the site-wide sign-up and a
// countdown, featuring the first coming-soon competition (or, before anything is published, the draft
// teaser: title, image and draw date only). Coming-soon cards below show their odds, tickets and price.
const noneLive = !competitions.some((c) => c.status === 'live');
const soonList = competitions.filter(isComingSoon);
const heroSoon = soonList.find((c) => c.badge) ?? soonList[0];
const teaser: CompetitionTeaser | null = heroSoon
  ? { slug: heroSoon.slug, title: heroSoon.title, image: heroSoon.images[0] ?? null, opensAt: heroSoon.opensAt, drawAt: heroSoon.drawAt }
  : upcoming;
const prelaunch = noneLive && teaser ? teaser : null;
const launchAt = nextOpening(competitions) ?? (upcoming?.opensAt && Date.parse(upcoming.opensAt) > Date.now() ? upcoming.opensAt : null);
const headline = launchAt ? `Launching ${launchDay(launchAt)}` : 'Launching soon';
// The draft teaser card only while nothing is published yet (a coming-soon card shows the real terms).
const draftCard = prelaunch && !heroSoon ? prelaunch : null;
const featured = prelaunch ? undefined : competitions.find((c) => c.badge) ?? competitions[0];
const allowance = featured && featured.ticketPrice > 0 ? await getAllowance(Astro.cookies, featured) : null;
if (allowance) Astro.response.headers.set('Cache-Control', 'private, no-store');
const latestWinner = winners[0];
const placeholders = Math.max(0, 3 - competitions.length - (draftCard ? 1 : 0));
const launchCd = prelaunch ? launchCountdown(prelaunch) : null;
const specs = featured?.specs ?? [];
const spec = (label: string) => specs.find((s) => s.label.toLowerCase() === label.toLowerCase())?.value;
const drawTime = featured ? new Date(featured.drawAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' }) : '';
const drawDay = featured ? new Date(featured.drawAt).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', timeZone: 'Europe/London' }).replace('/', '.') : '';
---
<Layout title="Home">
  <Ticker messages={settings.bannerMessages} />

  {prelaunch ? <LaunchHero teaser={prelaunch} headline={headline} /> : null}

  {featured ? (
    <section class="hero">
      <img src={featured.images[0]?.src} alt={featured.images[0]?.alt} class="hero-img" fetchpriority="high" decoding="async" />
      <div class="hero-shade"></div>
      <div class="container hero-inner">
        <div class="hero-copy hero-anim">
          <span class="chip chip--line hero-chip"><span class="dot"></span>Live now · Competition 01</span>
          <div class="stack" style="gap: 6px">
            <span class="kicker">Win this BMW</span>
            <h1 class="display display--xl">{featured.title.replace(/^BMW\s+/i, '')}</h1>
          </div>
          <p class="lead hero-lead">{featured.strapline}</p>
          <div class="hero-facts"><strong>Only {featured.totalTickets.toLocaleString('en-GB')} tickets</strong><strong>{odds(featured.totalTickets)} odds</strong><span>{ch.youtube ? 'Drawn live on our socials' : 'Drawn live on Instagram'}</span></div>
        </div>
        <div class="hero-card hero-anim-card">
          <EntryPanel competition={featured} settings={settings} variant="hero" allowance={allowance} />
        </div>
      </div>
    </section>
  ) : null}

  <section class="usp">
    <div class="container usp-grid" data-reveal-group>
      <div><b>01</b><span><strong>Better odds</strong><br />Low ticket numbers, always</span></div>
      <div><b>02</b><span><strong>Instant numbers</strong><br />Emailed at checkout</span></div>
      <div><b>03</b><span><strong>Drawn live</strong><br />{ch.youtube ? 'Instagram & YouTube' : ch.where}</span></div>
      <div><b>04</b><span><strong>Bundle deals</strong><br />Multi-buy ticket bundles</span></div>
    </div>
  </section>

  {featured ? (
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <div class="stack"><span class="eyebrow">The prize</span><h2 class="display display--m">Rare. Refreshed.<br />Ready to drive.</h2></div>
          <a href={`/competitions/${featured.slug}`} class="btn btn--outline">Full spec &amp; photos →</a>
        </div>
        <div class="bento" data-reveal-group>
          <div class="b-main zoom"><img src={featured.images[1]?.src ?? featured.images[0]?.src} alt={featured.images[1]?.alt ?? ''} loading="lazy" data-fade /></div>
          {spec('Built') ? <div class="b-tile b-light"><span class="label">Production</span><b class="b-big">{spec('Built')}</b><span class="small">Clubsports estimated ever made</span></div> : null}
          {spec('Gearbox') ? <div class="b-tile"><span class="label">Gearbox</span><b class="b-mid">{spec('Gearbox')}</b></div> : null}
          {spec('Paint') ? <div class="b-tile"><span class="label">Paint</span><b class="b-mid">{spec('Paint')}</b></div> : null}
          {featured.buildVideoUrl ? (
            <a href={featured.buildVideoUrl} class="b-video zoom"><img src={featured.images[2]?.src ?? featured.images[0]?.src} alt="" loading="lazy" /><span class="b-play"><span class="play"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></span>Watch the build</span></a>
          ) : null}
          <div class="b-wide">
            {['Interior', 'Audio', 'Engine'].map((l) => spec(l) ? <div><span class="label">{l}</span><b>{spec(l)}</b></div> : null)}
          </div>
        </div>
      </div>
    </section>
  ) : null}

  <section class="section section--alt">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="stack"><span class="eyebrow">{prelaunch ? 'Coming soon' : 'Live competitions'}</span><h2 class="display display--m">{prelaunch ? 'First up' : 'Pick your prize'}</h2></div>
        <a href="/competitions" class="link-caps">View all competitions →</a>
      </div>
      <div class="grid grid--cards cards" data-reveal-group>
        {draftCard ? <LaunchCard teaser={draftCard} id="grid-email" /> : null}
        {competitions.map((c) => <CompetitionCard competition={c} />)}
        {Array.from({ length: placeholders }, (_, i) => <ComingSoonCard n={competitions.length + (draftCard ? 1 : 0) + i + 1} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center-head" data-reveal><span class="eyebrow">How it works</span><h2 class="display display--m">Enter in three steps</h2></div>
      <ol class="steps" data-reveal-group>
        <li><b>01</b><span>Choose your tickets or a bundle</span></li>
        <li><b>02</b><span>Answer the question and check out securely</span></li>
        <li><b>03</b><span>Your numbers are emailed instantly</span></li>
      </ol>
      <div class="steps-cta">{prelaunch ? <a href="#first-access" class="btn">Get first access</a> : <a href="/competitions" class="btn">View competitions</a>}</div>
    </div>
  </section>

  {featured ? (
    <section class="section section--light">
      <div class="container split" data-reveal-group>
        <div class="stack" style="gap: 8px; flex: 1 1 520px">
          <span class="eyebrow" style="color:#555">Christmas Eve live draw</span>
          <span class="date">{drawDay}</span>
          <p class="body" style="color:#333; margin-top: 16px">The smaller prizes go first, then the Clubsport. Streamed live on {ch.where}. Turn on notifications so you don't miss your number.</p>
        </div>
        <div class="stack" style="flex: 1 1 380px">
          <div class="runorder"><span>Supporting prize draws</span><span>Before</span></div>
          <div class="runorder last"><span>{featured.title}</span><span>{drawTime}</span></div>
          {ch.primary ? <a href={ch.primary.url} class="btn btn--dark btn--block" style="margin-top: 24px">{ch.primary.label}</a> : null}
          {ch.instagram && ch.youtube ? <a href={ch.youtube.url} class="btn btn--block" style="margin-top: 10px; background:#fff; color:#000; border-color:#000">Watch on YouTube</a> : null}
        </div>
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container split" data-reveal-group>
      <div class="stack" style="gap: 24px; flex: 1 1 520px">
        <span class="eyebrow">From the WDS Originals workshop</span>
        <h2 class="display display--l">Dream it.<br />Build it.<br />Drive it.<br /><span class="inv">Win it.</span></h2>
        <p class="body" data-dream>WDS Originals builds high-performance and modern classic BMWs, from beautifully refreshed OEM+ examples to full race-inspired track day builds. Now is your chance to win them.</p>
        <div class="row" style="gap: 24px"><a href="/about" class="link-caps">Our story →</a><a href="https://wdsoriginals.com" class="link-caps">WDS Originals ↗</a></div>
      </div>
      {latestWinner ? (
        <div class="stack" style="gap: 16px; flex: 1 1 400px">
          <span class="eyebrow">Latest winner</span>
          <div class="card">
            {latestWinner.image ? <img src={thumb(latestWinner.image)} alt={`${latestWinner.name} with the ${latestWinner.prize}`} class="winner-img" loading="lazy" data-fade /> : <div class="ph">Winner photo</div>}
            <div class="card__body row-between winner-body"><div class="stack" style="gap: 6px"><span class="h3">{latestWinner.name}</span><span class="small muted">Won the {latestWinner.prize}</span></div><a href="/winners" class="link-caps small">All winners →</a></div>
          </div>
        </div>
      ) : null}
    </div>
  </section>

  {prelaunch ? null : (
  <section class="section section--tight" id="notify">
    <div class="container split" style="align-items: center" data-reveal>
      <div class="stack" style="gap: 12px; flex: 1 1 420px"><h2 class="display display--s">Get first access</h2><p class="body muted">New prizes, early-bird launches and live draw reminders. No spam.</p></div>
      <div style="flex: 1 1 460px"><SignupForm id="nl-email" label="Sign me up" source="home" /></div>
    </div>
  </section>
  )}

  {prelaunch ? (
    <div class="sticky-bar" slot="after">
      <div class="container">
        {prelaunch.image ? <img src={prelaunch.image.src} alt="" width="64" height="48" class="sb-img" /> : null}
        <div class="stack sb-text"><strong>{prelaunch.title}</strong>{launchCd ? <span class="small muted num">{launchCd.label} <span data-countdown={launchCd.at} data-countdown-text>{countdownParts(launchCd.at).text}</span></span> : <span class="small muted">Coming soon</span>}</div>
        <div class="sb-btns"><a href="#first-access" class="btn">Get first access</a></div>
      </div>
    </div>
  ) : featured ? (
    <div class="sticky-bar" slot="after">
      <div class="container">
        {featured.images[0] ? <img src={thumb(featured.images[1]?.src ?? featured.images[0]?.src)} alt="" width="64" height="48" class="sb-img" /> : null}
        <div class="stack sb-text"><strong>{featured.title}</strong><span class="small muted num">Live draw in <span data-countdown={featured.drawAt} data-countdown-text>{countdownParts(featured.drawAt).text}</span> · {percentSold(featured.ticketsSold, featured.totalTickets)}% sold</span></div>
        <div class="sb-btns"><a href={`/competitions/${featured.slug}`} class="btn">{featured.ticketPrice === 0 ? 'Enter free' : <>Enter · {money(featured.ticketPrice)}</>}</a></div>
      </div>
    </div>
  ) : null}
</Layout>

<style>
  .hero { position: relative; border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; animation: settle 2.6s var(--ease) both, fade 1.2s ease both; }
  .hero-anim > * { animation: rise 1.1s var(--ease) both; }
  .hero-anim > :nth-child(2) { animation-delay: .08s; }
  .hero-anim > :nth-child(3) { animation-delay: .16s; }
  .hero-anim > :nth-child(4) { animation-delay: .24s; }
  .hero-anim-card { animation: rise 1.2s var(--ease) .3s both; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.7) 38%, rgba(0,0,0,.15) 70%, rgba(0,0,0,.35) 100%), linear-gradient(0deg, #000 0%, rgba(0,0,0,0) 30%); }
  .hero-inner { position: relative; min-height: 700px; padding-top: 96px; padding-bottom: 72px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-end; }
  .hero-copy { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero-chip { align-self: flex-start; background: rgba(0,0,0,.5); border-color: rgba(255,255,255,.4); }
  .kicker { font-size: 22px; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: #d0d0d0; }
  .hero-lead { color: #d6d6d6; max-width: 500px; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-2); }
  .hero-facts strong { color: #fff; }
  .hero-card :global(.btn-pair .btn) { padding: 0 8px; font-size: 12px; letter-spacing: 0.08em; }
  .hero-card { flex: 0 1 400px; min-width: 0; background: rgba(8,8,8,.88); border: 1px solid rgba(255,255,255,.22); padding: 26px; }

  .usp { border-bottom: 1px solid var(--line); }
  .usp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .usp-grid > div { padding: 28px 24px; display: flex; gap: 14px; align-items: center; }
  .usp-grid > div + div { border-left: 1px solid var(--line); }
  .usp-grid b { font-size: 36px; line-height: 1; }
  .usp-grid span { font-size: 13px; line-height: 1.45; color: var(--muted-2); }
  .usp-grid strong { color: #fff; text-transform: uppercase; letter-spacing: 0.06em; }

  .bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, 210px); grid-auto-rows: auto; gap: 12px; }
  .b-main { grid-column: span 2; grid-row: span 2; }
  .b-main img, .b-video img { width: 100%; height: 100%; object-fit: cover; }
  .b-tile { border: 1px solid var(--line-2); padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; min-width: 0; transition: border-color .5s var(--ease); }
  .b-tile:hover { border-color: #fff; }
  .b-light { background: #fff; color: #000; border-color: #fff; }
  .b-light .label { color: #000; }
  .b-big { font-size: 56px; line-height: .9; letter-spacing: -0.03em; }
  .b-mid { font-size: 34px; line-height: .95; text-transform: uppercase; overflow-wrap: break-word; }
  .b-video { text-decoration: none; }
  .b-play { position: absolute; inset: 0; background: rgba(0,0,0,.55); display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; padding: 22px; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .play { width: 52px; height: 52px; border-radius: 50%; background: #fff; color: #000; display: flex; align-items: center; justify-content: center; transition: transform .6s var(--ease); }
  .b-video:hover .play { transform: scale(1.12); }
  .b-wide { grid-column: 1 / -1; border: 1px solid var(--line-2); padding: 24px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: end; }
  .b-wide b { display: block; margin-top: 6px; font-size: 18px; text-transform: uppercase; overflow-wrap: break-word; }
  @media (max-width: 900px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; grid-auto-rows: auto; } .bento > :not(.b-wide) { min-height: 168px; } .b-main { aspect-ratio: 4 / 3; min-height: 0 !important; } .b-tile { padding: 18px; } .b-wide { grid-template-columns: minmax(0, 1fr); } .b-big { font-size: 40px; } .b-mid { font-size: 24px; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .steps li { display: flex; flex-direction: column; gap: 10px; padding: 24px 24px 24px 0; font-size: 16px; color: #d0d0d0; }
  .steps li + li { padding-left: 24px; border-left: 1px solid var(--line-2); }
  .steps b { font-size: 32px; line-height: 1; color: #fff; }
  .steps-cta { display: flex; justify-content: center; margin-top: 32px; }
  .center-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin-bottom: 40px; }

  .split { display: flex; flex-wrap: wrap; gap: 56px; }
  .date { font-size: clamp(110px, 15vw, 200px); line-height: .82; font-weight: 700; letter-spacing: -0.05em; }
  .runorder { display: flex; justify-content: space-between; gap: 16px; padding: 22px 0; border-top: 2px solid #000; font-size: 18px; font-weight: 700; text-transform: uppercase; }
  .runorder span + span { color: #555; font-size: 15px; }
  .runorder.last { border-bottom: 2px solid #000; }
  .inv { display: inline-block; background: #fff; color: #000; padding: 4px 10px 0; margin-top: 6px; line-height: .95; }
  .winner-img { width: 100%; height: 340px; object-fit: cover; object-position: 50% 62%; }
  .row-between { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  @media (max-width: 1000px) {
    .hero-card { flex: 1 1 100%; max-width: 560px; }
    .hero-inner { min-height: 0; gap: 32px; }
  }
  @media (max-width: 600px) {
    .usp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .usp-grid > div { padding: 20px 4px; flex-direction: column; align-items: flex-start; gap: 8px; }
    .usp-grid > div + div { border-left: 0; border-top: 0; }
    .usp-grid > div:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line); }
    .usp-grid > div:nth-child(n+3) { border-top: 1px solid var(--line); }
    .usp-grid b { font-size: 28px; }
    .steps { grid-template-columns: minmax(0, 1fr); }
    .steps li, .steps li + li { flex-direction: row; align-items: center; gap: 16px; padding: 16px 0; border-left: 0; border-bottom: 1px solid var(--line-2); font-size: 15px; }
    .steps b { font-size: 22px; min-width: 32px; }
    .steps-cta { margin-top: 24px; }
    .steps-cta .btn { width: 100%; }
    .split { gap: 40px; }
    .winner-img { height: 300px; }
    .winner-body { flex-direction: column; align-items: flex-start; }
    .kicker { font-size: 16px; letter-spacing: .26em; }
    .hero-facts { gap: 8px 18px; font-size: 12px; }
    .date { font-size: 34vw; }
  }


  .sb-img { width: 64px; height: 48px; object-fit: cover; }
  .sb-text { flex: 1 1 240px; gap: 2px; font-size: 14px; text-transform: uppercase; }
  .sb-text .small { text-transform: none; }
  .sb-btns { flex: 0 1 420px; }
  .sb-btns .btn { min-height: 48px; font-size: 12px; padding: 0 10px; }
  @media (max-width: 600px) { .sb-img, .sb-text { display: none; } .sb-btns { flex: 1 1 100%; } .hero-inner { padding-top: 40px; padding-bottom: 40px; } .hero-card { padding: 16px; } .hero-shade { background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.75) 45%, #000 100%); } }
</style>
