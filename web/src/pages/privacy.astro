---
import LegalPage from '../components/LegalPage.astro';
import { getSettings } from '../lib/api';
const s = await getSettings();
const sections: [string, string[]][] = [
  ['Who we are', [`${s.legalName} (company no. ${s.companyNumber}), trading as ${s.tradingName}, is the data controller. Registered office: ${s.registeredOffice}. Contact: ${s.supportEmail}.`]],
  ['What we collect', ['Your name, contact details, date of birth and address; your entries and orders; and, if you win, the ID you upload for verification. Card details are handled by our payment provider on their secure checkout page, not stored by us.']],
  ['How we use it', ['To run competitions and draws, issue ticket numbers, contact winners, prevent fraud, enforce spending limits and self-exclusion, and, if you opt in, send you news about competitions.']],
  ['Lawful basis', ['We use your details to provide the competitions you enter (contract), to meet our legal obligations such as age checks and keeping records, to prevent fraud (legitimate interests), and for marketing only if you opt in (consent).']],
  ['Who we share it with', ["We share your details only with the providers who help us run the site: our payment provider (Cashflows, for card payments), our website hosting provider (servers in London, UK) and our email provider (to send account and entry emails). They may only use your details to provide their service to us. We also share details with regulators, the police or other authorities where the law requires it.", "If you win, we'll publish your first name, surname and county, and a photo of you with your prize where you've agreed to one, on our website and social media. You can ask us not to publish your name or photo; if you do, we may still have to share these details with the Advertising Standards Authority or another regulator if asked."]],
  ["International transfers", ["Some of our providers may process data outside the UK. Where they do, we make sure appropriate safeguards are in place, such as the UK International Data Transfer Agreement or Addendum, or the UK–US Data Bridge."]],
  ["How long we keep it", ["We keep account, order and entry records for six years after the end of the financial year they relate to, to meet our accounting and legal obligations. Winner ID documents are deleted within 30 days of the prize being handed over, unless we need them for longer for a legal reason. If you unsubscribe from marketing, we keep a record so we don't email you again."]],
  ['Your rights', ["Under UK data protection law you can ask to access, correct or delete your data, object to some uses, and withdraw consent to marketing at any time. You can also complain to the Information Commissioner's Office (ico.org.uk).", `We'll respond to requests within one month. Contact us at ${s.supportEmail}.`]],
  ["Age", ["Our competitions are for people aged 18 or over, and we don't knowingly collect data from anyone younger."]],
  ['Cookies', ['How we use cookies is in our <a href="/cookies">cookies policy</a>.']],
];
---
<LegalPage title="Privacy policy" heading="Privacy policy" sections={sections} updated="20 November 2026" />
