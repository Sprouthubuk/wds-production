---
import LegalPage from '../components/LegalPage.astro';
const sections: [string, string[]][] = [
  ['How to complain', ['Contact us using the details on the <a href="/contact">contact page</a>. Tell us your name, your order number or draw reference if you have one, and what went wrong.']],
  ["What happens next", ["We'll acknowledge your complaint within 5 working days and aim to give you a full response within 14 days. If it's taking longer, we'll tell you why."]],
  ["If you're not happy with our response", ["You can raise concerns about our advertising with the Advertising Standards Authority (asa.org.uk) and about how we use your data with the Information Commissioner's Office (ico.org.uk). This doesn't affect your right to go to court."]],
];
---
<LegalPage title={'Complaints'} heading={'Complaints'} sections={sections} updated="20 November 2026" />
