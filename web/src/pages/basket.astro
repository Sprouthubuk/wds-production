---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { currentUser } from '../lib/session';
import { usingSampleData } from '../lib/api';

const me = usingSampleData ? null : await currentUser(Astro.cookies);
const prefill = me ? { email: me.email, name: `${me.firstName} ${me.lastName}`.trim(), phone: me.phone ?? '', dob: me.dateOfBirth ?? '', credit: me.siteCredit } : null;
---
<Layout title="Basket">
  <PageHero eyebrow="Basket" title="Your basket" />
  <section class="section" style="border-bottom: 0">
    <div class="container" data-basket data-prefill={JSON.stringify(prefill)}>
      <div class="empty stack" data-empty hidden>
        <p class="lead">Your basket is empty.</p>
        <div class="row" style="gap: 12px"><a href="/competitions" class="btn">View competitions</a><a href="/free-postal-entry" class="btn btn--outline">Enter free by post</a></div>
      </div>

      <form class="layout" data-form novalidate>
        <div class="left">
          <div class="lines" data-lines></div>

          <div class="stack" style="gap: 16px">
            <div class="head-row"><h2 class="h3">Your details</h2>{me ? <span class="small muted">Signed in as {me.email}</span> : <a href="/sign-in?next=/basket" class="small">Have an account? Sign in</a>}</div>
            <div class="field"><label for="b-em">Email</label><input id="b-em" name="email" type="email" required autocomplete="email" /></div>
            <div class="form-grid">
              <div class="field"><label for="b-n">Full name</label><input id="b-n" name="name" required autocomplete="name" /></div>
              <div class="field"><label for="b-t">Mobile</label><input id="b-t" name="phone" type="tel" required autocomplete="tel" /></div>
            </div>
            <div class="field"><label for="b-dob">Date of birth</label><input id="b-dob" name="dob" type="date" required autocomplete="bday" /><span class="hint">You must be 18 or over to enter.</span></div>
            <label class="check" for="b-age"><input id="b-age" name="age" type="checkbox" required />I'm 18 or over and live in the UK.</label>
            <label class="check" for="b-terms"><input id="b-terms" name="terms" type="checkbox" required /><span>I agree to the <a href="/terms">terms</a>. I know I can <a href="/free-postal-entry">enter free by post</a> instead.</span></label>
            <label class="check" for="b-mk"><input id="b-mk" name="marketing" type="checkbox" />Email me about new competitions and live draws (optional).</label>
            {!me ? <label class="check" for="b-acc"><input id="b-acc" name="createAccount" type="checkbox" />Create an account so I can see my tickets any time (we'll email you a link to set a password).</label> : null}
          </div>
        </div>

        <aside class="summary">
          <h2 class="h3">Order summary</h2>
          <div class="code">
            <label for="b-code" class="sr-only">Discount code</label>
            <input id="b-code" name="discountCode" placeholder="Discount code" autocomplete="off" />
          </div>
          {prefill && prefill.credit > 0 ? <label class="check" for="b-credit"><input id="b-credit" name="useCredit" type="checkbox" checked />Use site credit (£{prefill.credit.toFixed(2)} available)</label> : null}
          <div class="rows" data-totals></div>
          <p class="alert alert--error" data-error role="alert" hidden></p>
          <button class="btn btn--block btn--lg" type="submit" data-submit>Continue to secure payment →</button>
          <span class="small muted center">You'll pay by card on our payment provider's secure page, then come straight back here for your ticket numbers.</span>
          <div class="post-alt"><span class="muted-2">Prefer not to pay?</span><a href="/free-postal-entry" class="link-caps small">Enter free by post →</a></div>
        </aside>
      </form>
    </div>
  </section>
</Layout>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .left { flex: 1.5 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 36px; }
  .summary { flex: 1 1 360px; min-width: 0; border: 1px solid #fff; padding: 28px; display: flex; flex-direction: column; gap: 18px; position: sticky; top: 24px; }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .code input { width: 100%; min-height: 48px; padding: 0 14px; background: #0d0d0d; border: 1px solid var(--line-3); color: #fff; font-size: 15px; }
  .center { text-align: center; }
  .post-alt { border-top: 1px solid var(--line-2); padding-top: 14px; display: flex; justify-content: space-between; gap: 12px; font-size: 13px; }
  .muted-2 { color: var(--muted-2); }
  .empty { gap: 24px; }
  .lines :global(.line) { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; padding: 22px 0; border-top: 1px solid var(--line-2); }
  .lines :global(.line:last-child) { border-bottom: 1px solid var(--line-2); }
  .lines :global(.line img) { width: 120px; aspect-ratio: 4 / 3; object-fit: cover; }
  .lines :global(.info) { flex: 1 1 200px; display: flex; flex-direction: column; gap: 6px; }
  .lines :global(.step) { display: flex; align-items: center; border: 1px solid var(--line-3); }
  .lines :global(.step button) { width: 48px; height: 48px; background: transparent; border: 0; color: #fff; font-size: 22px; cursor: pointer; }
  .lines :global(.step span) { min-width: 48px; text-align: center; font-size: 18px; font-weight: 700; }
  .lines :global(.price) { flex: 0 0 120px; text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .lines :global(.price b) { font-size: 20px; }
  .lines :global(.remove) { background: none; border: 0; padding: 0; color: var(--muted); font-size: 13px; text-decoration: underline; cursor: pointer; align-self: flex-start; }
  @media (max-width: 900px) { .summary { position: static; } }
</style>

<script>
  import { lineCap, readBasket, setQty } from '../lib/basket';
  import { money, priceFor, savingFor } from '../lib/pricing';

  const root = document.querySelector<HTMLElement>('[data-basket]')!;
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const linesEl = root.querySelector<HTMLElement>('[data-lines]')!;
  const totalsEl = root.querySelector<HTMLElement>('[data-totals]')!;
  const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
  const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
  const prefill = JSON.parse(root.dataset.prefill || 'null');
  if (prefill) {
    (form.elements.namedItem('email') as HTMLInputElement).value = prefill.email || '';
    (form.elements.namedItem('name') as HTMLInputElement).value = prefill.name || '';
    (form.elements.namedItem('phone') as HTMLInputElement).value = prefill.phone || '';
    (form.elements.namedItem('dob') as HTMLInputElement).value = prefill.dob || '';
  }

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  function render() {
    const lines = readBasket();
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = lines.length > 0;
    form.hidden = lines.length === 0;
    linesEl.innerHTML = '';
    let total = 0, saving = 0, count = 0;
    for (const l of lines) {
      const lineTotal = priceFor(l.qty, l.ticketPrice, l.bundles);
      const lineSave = savingFor(l.qty, l.ticketPrice, l.bundles);
      total += lineTotal; saving += lineSave; count += l.qty;
      const div = document.createElement('div');
      div.className = 'line';
      div.innerHTML = `
        <img src="${esc(l.image.replace('.jpg', '-720.jpg'))}" alt="" />
        <div class="info"><strong>${esc(l.title)}</strong><span class="small muted">${money(l.ticketPrice)} each · <span data-o></span></span><button type="button" class="remove" data-remove>Remove</button></div>
        <div class="step"><button type="button" aria-label="One fewer ticket" data-d="-1">−</button><span aria-live="polite">${l.qty}</span><button type="button" aria-label="One more ticket" data-d="1">+</button></div>
        <div class="price"><b>${money(lineTotal)}</b>${lineSave > 0 ? `<span class="small">Bundle saving ${money(lineSave)}</span>` : ''}</div>`;
      div.querySelector<HTMLElement>('[data-o]')!.textContent = l.qty ? `${l.qty} ticket${l.qty === 1 ? '' : 's'}` : '';
      div.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) => b.addEventListener('click', () => { setQty(l.competitionId, l.qty + Number(b.dataset.d)); render(); }));
      div.querySelector<HTMLButtonElement>('[data-remove]')!.addEventListener('click', () => { setQty(l.competitionId, 0); render(); });
      if (l.qty >= lineCap(l)) div.querySelector<HTMLButtonElement>('[data-d="1"]')!.disabled = true;
      linesEl.appendChild(div);
    }
    totalsEl.innerHTML = `
      <div><span>${count} ticket${count === 1 ? '' : 's'}</span><span>${money(total + saving)}</span></div>
      <div><span>Bundle saving</span><span>−${money(saving)}</span></div>
      <div><span>Total</span><span>${money(total)}</span></div>`;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const dob = new Date(String(fd.get('dob')));
    const age = (Date.now() - dob.getTime()) / (365.25 * 86_400_000);
    if (!(age >= 18)) { errorEl.textContent = 'You must be 18 or over to enter.'; errorEl.hidden = false; return; }
    submit.disabled = true; submit.textContent = 'Taking you to secure payment…';
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer: { email: fd.get('email'), name: fd.get('name'), phone: fd.get('phone'), dateOfBirth: fd.get('dob') },
          items: readBasket().map((l) => ({ competitionId: l.competitionId, qty: l.qty })),
          discountCode: fd.get('discountCode') || null,
          useCredit: fd.get('useCredit') === 'on',
          marketingOptIn: fd.get('marketing') === 'on',
          createAccount: fd.get('createAccount') === 'on',
          ageConfirmed: fd.get('age') === 'on',
          termsAccepted: fd.get('terms') === 'on',
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.redirectUrl) throw new Error(data.message || 'Something went wrong. Please try again.');
      window.location.href = data.redirectUrl;
    } catch (err) {
      errorEl.textContent = (err as Error).message; errorEl.hidden = false;
      submit.disabled = false; submit.textContent = 'Continue to secure payment →';
    }
  });
  render();
</script>
