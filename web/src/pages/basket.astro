---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { currentUser } from '../lib/session';
import { usingSampleData } from '../lib/api';

const me = usingSampleData ? null : await currentUser(Astro.cookies);
const prefill = me ? { email: me.email, name: `${me.firstName} ${me.lastName}`.trim(), phone: me.phone ?? '', dob: me.dateOfBirth ?? '', credit: me.siteCredit } : null;
---
<Layout title="Basket">
  <PageHero eyebrow="Basket" title="Your basket" />
  <section class="section" style="border-bottom: 0">
    <div class="container" data-basket data-prefill={JSON.stringify(prefill)}>
      <div class="empty stack" data-empty hidden>
        <p class="lead">Your basket is empty.</p>
        <div class="row" style="gap: 12px"><a href="/competitions" class="btn">View competitions</a></div>
      </div>

      <form class="layout" data-form novalidate>
        <div class="left">
          <div class="lines" data-lines></div>

          <div class="skill stack" data-skill hidden>
            <div class="stack" style="gap: 6px">
              <h2 class="h3">Answer the question</h2>
              <p class="small muted" style="margin:0">To enter online, answer this question correctly. You can try again if you get it wrong; you won't be charged unless your answer is right.</p>
            </div>
            <div class="stack" style="gap: 20px" data-skill-list></div>
          </div>

          <div class="stack" style="gap: 16px">
            <div class="head-row"><h2 class="h3">Your details</h2>{me ? <span class="small muted">Signed in as {me.email}</span> : <a href="/sign-in?next=/basket" class="small">Have an account? Sign in</a>}</div>
            <div class="field"><label for="b-em">Email</label><input id="b-em" name="email" type="email" required autocomplete="email" /></div>
            <div class="form-grid">
              <div class="field"><label for="b-n">Full name</label><input id="b-n" name="name" required autocomplete="name" /></div>
              <div class="field"><label for="b-t">Mobile</label><input id="b-t" name="phone" type="tel" required autocomplete="tel" /></div>
            </div>
            <div class="field"><label for="b-dob">Date of birth</label><input id="b-dob" name="dob" type="date" required autocomplete="bday" /><span class="hint">You must be 18 or over to enter.</span></div>
            <label class="check" for="b-age"><input id="b-age" name="age" type="checkbox" required />I'm 18 or over and live in the UK.</label>
            <label class="check" for="b-terms"><input id="b-terms" name="terms" type="checkbox" required /><span>I'm 18 or over, I agree to the <a href="/terms">terms &amp; conditions</a>, and I understand my entry is completed when my ticket numbers are issued, so I can't cancel it afterwards.</span></label>
            <p class="small muted" style="margin:0">You can <a href="/free-postal-entry">enter free by post</a> instead.</p>
            <p class="small muted" style="margin:0">Play responsibly: set a spend limit, take a break or self-exclude in your account. <a href="/responsible-play">Responsible play and support</a></p>
            <label class="check" for="b-mk"><input id="b-mk" name="marketing" type="checkbox" />Email me about new competitions and live draws (optional).</label>
            {!me ? <label class="check" for="b-acc"><input id="b-acc" name="createAccount" type="checkbox" />Create an account so I can see my tickets any time (we'll email you a link to set a password).</label> : null}
          </div>
        </div>

        <aside class="summary">
          <h2 class="h3">Order summary</h2>
          <div class="code">
            <label for="b-code" class="sr-only">Discount code</label>
            <input id="b-code" name="discountCode" placeholder="Discount code" autocomplete="off" />
          </div>
          {prefill && prefill.credit > 0 ? <label class="check" for="b-credit"><input id="b-credit" name="useCredit" type="checkbox" checked />Use site credit (£{prefill.credit.toFixed(2)} available)</label> : null}
          <div class="rows" data-totals></div>
          <p class="alert alert--error" data-error role="alert" hidden></p>
          <button class="btn btn--block btn--lg" type="submit" data-submit>Continue to secure payment →</button>
          <span class="small muted center">You'll pay by debit card, Apple Pay or Google Pay on our payment provider's secure page, then come straight back here for your ticket numbers.</span>
        </aside>
      </form>
    </div>
  </section>
</Layout>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .left { flex: 1.5 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 36px; }
  .summary { flex: 1 1 360px; min-width: 0; border: 1px solid #fff; padding: 28px; display: flex; flex-direction: column; gap: 18px; position: sticky; top: 24px; }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .code input { width: 100%; min-height: 48px; padding: 0 14px; background: #0d0d0d; border: 1px solid var(--line-3); color: #fff; font-size: 15px; }
  .center { text-align: center; }
  .muted-2 { color: var(--muted-2); }
  .empty { gap: 24px; }
  .skill { gap: 18px; border: 1px solid #fff; padding: 22px; }
  .skill :global(fieldset) { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .skill :global(legend) { padding: 0 0 8px; font-weight: 700; font-size: 16px; line-height: 1.35; }
  .skill :global(legend .for) { display: block; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .skill :global(.opt) { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 10px 14px; border: 1px solid var(--line-3); cursor: pointer; }
  .skill :global(.opt:has(input:checked)) { border-color: #fff; background: #111; }
  .skill :global(.opt input) { width: 20px; height: 20px; flex: none; accent-color: #fff; }
  .skill :global(.skill-wrong) { color: var(--amber, #f0b429); font-weight: 700; font-size: 14px; margin: 0; }
  @media (max-width: 600px) { .skill { padding: 16px; } }
  .lines :global(.line) { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; padding: 22px 0; border-top: 1px solid var(--line-2); }
  .lines :global(.line:last-child) { border-bottom: 1px solid var(--line-2); }
  .lines :global(.line img) { width: 120px; aspect-ratio: 4 / 3; object-fit: cover; }
  .lines :global(.info) { flex: 1 1 200px; display: flex; flex-direction: column; gap: 6px; }
  .lines :global(.step) { display: flex; align-items: center; border: 1px solid var(--line-3); }
  .lines :global(.step button) { width: 48px; height: 48px; background: transparent; border: 0; color: #fff; font-size: 22px; cursor: pointer; }
  .lines :global(.step span) { min-width: 48px; text-align: center; font-size: 18px; font-weight: 700; }
  .lines :global(.price) { flex: 0 0 120px; text-align: right; display: flex; flex-direction: column; gap: 2px; }
  .lines :global(.price b) { font-size: 20px; }
  .lines :global(.line-warn) { color: var(--amber, #f0b429); font-weight: 700; }
  .lines :global(.remove) { background: none; border: 0; padding: 0; color: var(--muted); font-size: 13px; text-decoration: underline; cursor: pointer; align-self: flex-start; }
  @media (max-width: 900px) { .summary { position: static; } }
</style>

<script>
  import { lineCap, readBasket, setQty } from '../lib/basket';
  import { thumb } from '../lib/images';
  import { canAddLine, maxPerPersonLine } from '../lib/per-person';
  import { money, priceFor, savingFor } from '../lib/pricing';

  const root = document.querySelector<HTMLElement>('[data-basket]')!;
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const linesEl = root.querySelector<HTMLElement>('[data-lines]')!;
  const totalsEl = root.querySelector<HTMLElement>('[data-totals]')!;
  const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
  const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
  const prefill = JSON.parse(root.dataset.prefill || 'null');
  const skillEl = root.querySelector<HTMLElement>('[data-skill]')!;
  const skillList = root.querySelector<HTMLElement>('[data-skill-list]')!;
  type Skill = { question: string; options: string[] };
  // The skill question for each paid competition in the basket, as the API sends it (never with the answer).
  let questions: { competitionId: number; title: string; q: Skill }[] = [];

  // The per-person maximum of each competition as the API has it now, and what this customer already holds (signed in).
  const limits = new Map<number, { max: number | null; held: number }>();
  const capOf = (l: { competitionId: number; maxPerPerson: number | null }) => {
    const x = limits.get(l.competitionId);
    return x ? (x.max === null ? Infinity : Math.max(0, x.max - x.held)) : lineCap(l);
  };

  function renderSkill() {
    const lines = readBasket();
    const keep = new Map<number, string>();
    skillList.querySelectorAll<HTMLInputElement>('input:checked').forEach((i) => keep.set(Number(i.dataset.cid), i.value));
    skillList.innerHTML = '';
    for (const { competitionId, title, q } of questions) {
      if (!lines.some((l) => l.competitionId === competitionId)) continue;
      const fs = document.createElement('fieldset');
      fs.dataset.skillFor = String(competitionId);
      fs.innerHTML = `<legend>${questions.length > 1 ? `<span class="for">${esc(title)}</span>` : ''}${esc(q.question)}</legend>`
        + q.options.map((o, i) => `<label class="opt"><input type="radio" name="skill-${competitionId}" value="${i}" data-cid="${competitionId}" required ${keep.get(competitionId) === String(i) ? 'checked' : ''} /><span>${esc(o)}</span></label>`).join('')
        + '<p class="skill-wrong" role="alert" data-skill-wrong hidden></p>';
      fs.addEventListener('change', () => { const w = fs.querySelector<HTMLElement>('[data-skill-wrong]'); if (w) w.hidden = true; });
      skillList.appendChild(fs);
    }
    skillEl.hidden = !skillList.children.length;
  }
  if (prefill) {
    (form.elements.namedItem('email') as HTMLInputElement).value = prefill.email || '';
    (form.elements.namedItem('name') as HTMLInputElement).value = prefill.name || '';
    (form.elements.namedItem('phone') as HTMLInputElement).value = prefill.phone || '';
    (form.elements.namedItem('dob') as HTMLInputElement).value = prefill.dob || '';
  }

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  function render() {
    const lines = readBasket();
    root.querySelector<HTMLElement>('[data-empty]')!.hidden = lines.length > 0;
    form.hidden = lines.length === 0;
    linesEl.innerHTML = '';
    let total = 0, saving = 0, count = 0;
    for (const l of lines) {
      const lineTotal = priceFor(l.qty, l.ticketPrice, l.bundles);
      const lineSave = savingFor(l.qty, l.ticketPrice, l.bundles);
      total += lineTotal; saving += lineSave; count += l.qty;
      const div = document.createElement('div');
      div.className = 'line';
      div.dataset.cid = String(l.competitionId);
      div.innerHTML = `
        <img src="${esc(thumb(l.image))}" alt="" />
        <div class="info"><strong>${esc(l.title)}</strong><span class="small muted">${money(l.ticketPrice)} each · <span data-o></span></span><button type="button" class="remove" data-remove>Remove</button></div>
        <div class="step"><button type="button" aria-label="One fewer ticket" data-d="-1">−</button><span aria-live="polite">${l.qty}</span><button type="button" aria-label="One more ticket" data-d="1">+</button></div>
        <div class="price"><b>${money(lineTotal)}</b>${lineSave > 0 ? `<span class="small">Bundle saving ${money(lineSave)}</span>` : ''}</div>`;
      div.querySelector<HTMLElement>('[data-o]')!.textContent = l.qty ? `${l.qty} ticket${l.qty === 1 ? '' : 's'}` : '';
      div.querySelectorAll<HTMLButtonElement>('[data-d]').forEach((b) => b.addEventListener('click', () => { setQty(l.competitionId, l.qty + Number(b.dataset.d), capOf(l)); render(); }));
      div.querySelector<HTMLButtonElement>('[data-remove]')!.addEventListener('click', () => { setQty(l.competitionId, 0); render(); });
      linesEl.appendChild(div);
      showCap(l);
    }
    totalsEl.innerHTML = `
      <div><span>${count} ticket${count === 1 ? '' : 's'}</span><span>${money(total + saving)}</span></div>
      <div><span>Bundle saving</span><span>−${money(saving)}</span></div>
      <div><span>Total</span><span>${money(total)}</span></div>`;
    void checkOpen();
  }

  /** The per-person maximum on a line, what can still be added, and the + button stopping there. */
  function showCap(l: { competitionId: number; qty: number; maxPerPerson: number | null }) {
    const div = linesEl.querySelector<HTMLElement>(`[data-cid="${l.competitionId}"]`);
    if (!div) return;
    div.querySelector<HTMLButtonElement>('[data-d="1"]')!.disabled = l.qty >= capOf(l);
    div.querySelector('[data-line-max]')?.remove();
    const x = limits.get(l.competitionId);
    const max = x ? x.max : l.maxPerPerson;
    if (max === null) return;
    const el = document.createElement('span');
    el.className = 'small muted';
    el.dataset.lineMax = '';
    el.textContent = x && x.held > 0 && x.held < max ? `${maxPerPersonLine(max)}. ${canAddLine(max, x.held)}.` : `${maxPerPersonLine(max)}.`;
    div.querySelector('.info')!.insertBefore(el, div.querySelector('[data-remove]'));
  }

  // The API's price/availability check: a competition that isn't open yet (coming soon) or has closed
  // can't be checked out, whatever this page thinks (checkout refuses it too).
  let checkSeq = 0;
  async function checkOpen() {
    const lines = readBasket();
    const seq = ++checkSeq;
    if (!lines.length) return;
    try {
      const res = await fetch('/api/basket/quote', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: lines.map((l) => ({ competitionId: l.competitionId, qty: l.qty })) }) });
      if (!res.ok || seq !== checkSeq) return;
      const { data } = await res.json() as { data: { competitionId: number; open: boolean; message: string | null; maxPerPerson?: number | null; held?: number | null; skillQuestion?: Skill | null }[] };
      for (const q of data) if (q.maxPerPerson !== undefined) limits.set(q.competitionId, { max: q.maxPerPerson, held: q.held ?? 0 });
      // More in the basket than they can still add: brought down to it (nothing left is marked below instead).
      const over = lines.filter((l) => capOf(l) > 0 && l.qty > capOf(l));
      if (over.length) {
        for (const l of over) setQty(l.competitionId, capOf(l), capOf(l));
        render();
        return;
      }
      lines.forEach(showCap);
      questions = data.filter((q) => q.skillQuestion).map((q) => ({ competitionId: q.competitionId, title: lines.find((l) => l.competitionId === q.competitionId)?.title ?? '', q: q.skillQuestion! }));
      renderSkill();
      const full = (q: { competitionId: number }) => { const x = limits.get(q.competitionId); return !!x && x.max !== null && x.held >= x.max; };
      const blocked = data.filter((q) => !q.open || full(q));
      linesEl.querySelectorAll('[data-line-warn]').forEach((el) => el.remove());
      for (const q of blocked) {
        const info = linesEl.querySelector<HTMLElement>(`[data-cid="${q.competitionId}"] .info`);
        if (!info) continue;
        const warn = document.createElement('span');
        warn.className = 'small line-warn';
        warn.dataset.lineWarn = '';
        const x = limits.get(q.competitionId);
        warn.textContent = q.open && x ? `${canAddLine(x.max!, x.held)} for this competition.` : q.message ?? 'This competition is not open for entries.';
        info.appendChild(warn);
      }
      submit.disabled = blocked.length > 0;
      if (blocked.length) {
        errorEl.textContent = blocked.every((q) => !q.open)
          ? 'Remove the competitions marked above to continue: they are not open for entries right now.'
          : 'Remove the competitions marked above to continue.';
        errorEl.hidden = false;
      } else if (errorEl.textContent?.startsWith('Remove the competitions')) {
        errorEl.hidden = true;
      }
    } catch {
      /* offline: checkout still checks everything */
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    // The skill question first: a friendly nudge here; the API checks the answer itself.
    const unanswered = [...skillList.querySelectorAll<HTMLFieldSetElement>('fieldset')].find((fs) => !fs.querySelector('input:checked'));
    if (unanswered) {
      errorEl.textContent = 'Answer the question above to continue.'; errorEl.hidden = false;
      unanswered.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    if (!form.reportValidity()) return;
    const fd = new FormData(form);
    const dob = new Date(String(fd.get('dob')));
    const age = (Date.now() - dob.getTime()) / (365.25 * 86_400_000);
    if (!(age >= 18)) { errorEl.textContent = 'You must be 18 or over to enter.'; errorEl.hidden = false; return; }
    submit.disabled = true; submit.textContent = 'Taking you to secure payment…';
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer: { email: fd.get('email'), name: fd.get('name'), phone: fd.get('phone'), dateOfBirth: fd.get('dob') },
          items: readBasket().map((l) => ({ competitionId: l.competitionId, qty: l.qty })),
          discountCode: fd.get('discountCode') || null,
          useCredit: fd.get('useCredit') === 'on',
          marketingOptIn: fd.get('marketing') === 'on',
          createAccount: fd.get('createAccount') === 'on',
          ageConfirmed: fd.get('age') === 'on',
          termsAccepted: fd.get('terms') === 'on',
          skillAnswers: Object.fromEntries([...skillList.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => [i.dataset.cid, Number(i.value)])),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (data.code === 'skill_wrong') {
        // Wrong answer: nothing was created and nothing was paid. Say so by the question and let them try again.
        const fs = skillList.querySelector<HTMLFieldSetElement>(`[data-skill-for="${data.competitionId}"]`);
        if (!fs) await checkOpen(); // the question hadn't loaded yet: show it now
        const target = skillList.querySelector<HTMLFieldSetElement>(`[data-skill-for="${data.competitionId}"]`);
        target?.querySelectorAll<HTMLInputElement>('input').forEach((i) => { i.checked = false; });
        const w = target?.querySelector<HTMLElement>('[data-skill-wrong]');
        if (w) { w.textContent = data.message; w.hidden = false; target!.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        else { errorEl.textContent = data.message; errorEl.hidden = false; }
        submit.disabled = false; submit.textContent = 'Continue to secure payment →';
        return;
      }
      if (!res.ok || !data.redirectUrl) throw new Error(data.message || 'Something went wrong. Please try again.');
      window.location.href = data.redirectUrl;
    } catch (err) {
      errorEl.textContent = (err as Error).message; errorEl.hidden = false;
      submit.disabled = false; submit.textContent = 'Continue to secure payment →';
    }
  });
  render();
</script>
