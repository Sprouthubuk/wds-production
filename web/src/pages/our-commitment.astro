---
import LegalPage from '../components/LegalPage.astro';
const sections: [string, string[]][] = [
  ['Fair competitions', ['Every entry, online or by post, gets a ticket number from the same run and goes into the same draw. Every draw is live, and every result is published so anyone can check it on <a href="/verify">Verify a draw</a>.']],
  ['Free postal entry', ['Every paid competition can be entered free by post. See <a href="/free-postal-entry">Free postal entry</a>.']],
  ['Playing responsibly', ['You can set limits, take a break or self-exclude at any time. See <a href="/responsible-play">Responsible play</a>.']],
];
---
<LegalPage title={'Our commitment'} heading={'Our commitment'} sections={sections} />
